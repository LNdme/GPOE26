<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Évaluations des agents (lot A0 de docs/PLAN-AGENT-NOYAU.md).
    Rejoue les cas de evals/cases contre les services qui tournent (Aspire), note chaque réponse par des règles
    et, en option, par un modèle juge fixe. Ne fait pas partie de `dotnet test` : chaque cas coûte des appels au modèle.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GPOE26.Evals</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GPOE26.ServiceDefaults\GPOE26.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
