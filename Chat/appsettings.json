{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "LlmProvider": "OpenRouter",

  // ⚠️ Aucune clé d'API ici. OpenRouter__ApiKey est injectée par l'AppHost, depuis le
  // paramètre secret « openrouter-api-key » (user-secrets de GPOE26.AppHost).
  //
  // Les identifiants de modèles sont à choisir sur https://openrouter.ai/models — le
  // catalogue évolue, et c'est ici que se règle « quel LLM pour quel agent » :
  //   Vision        → doit accepter les images (transcription des photos de cours)
  //   Structurateur → mise en forme du cours, à privilégier en qualité
  //   Routeur       → classification courte et fréquente, un petit modèle suffit
  //   Tuteur        → la réponse lue par l'élève
  //   Embedding     → doit produire des vecteurs de la dimension déclarée ci-dessous
  //   Voix          → synthèse vocale des explications ; "Voice" doit être un identifiant
  //                   de voix accepté par CE modèle (voir sa fiche sur openrouter.ai)
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Title": "GPOE26",
    "DefaultModel": "openai/gpt-4o-mini",
    "EmbeddingDimensions": 1536,
    "Voice": "alloy",
    "MaxSpeechCharacters": 2000,
    "Models": {
      "Vision": "openai/gpt-4o-mini",
      "Structurateur": "openai/gpt-4o-mini",
      "Routeur": "openai/gpt-4o-mini",
      "Retriever": "openai/gpt-4o-mini",
      "Tuteur": "openai/gpt-4o-mini",
      "Exercice": "openai/gpt-4o-mini",
      "Relecteur": "openai/gpt-4o-mini",
      "Memoire": "openai/gpt-4o-mini",
      "Embedding": "openai/text-embedding-3-small",
      "Voix": "openai/gpt-4o-mini-tts"
    }
  },

  "AllowedHosts": "*"
}
