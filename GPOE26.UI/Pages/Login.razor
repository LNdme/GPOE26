@page "/login"
@layout FocusLayout
@inject IAccountApi Account
@inject SessionState Session
@inject NavigationManager Nav

<PageTitle>Connexion — GPOE26</PageTitle>

<div class="ob" style="background:#fff">
    <form class="ob-panel" style="justify-content:center; gap:20px; max-width:440px" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="ga-row" style="justify-content:center">
            <span class="ga-avatar" style="background:var(--ga-navy); color:#fff; border-radius:12px; width:42px; height:42px"><Icon Name="logo" Size="24" Stroke="2" /></span>
            <span style="font-family:var(--ga-display); font-weight:600; font-size:30px">GPOE26</span>
        </div>
        <div class="ob-title">
            <h1>Content de te revoir</h1>
            <p>Connecte-toi pour reprendre là où tu t'es arrêté.</p>
        </div>

        @* Élève d'un établissement : code de l'établissement + matricule (docs/PLAN-ETABLISSEMENT-2.md, P3) *@
        <div class="ga-tabs" role="tablist" aria-label="Façon de se connecter">
            <button type="button" role="tab" aria-selected="@Aria.State(!_byMatricule)" class="@(!_byMatricule ? "on" : "")" @onclick="() => Switch(false)">E-mail ou nom d'utilisateur</button>
            <button type="button" role="tab" aria-selected="@Aria.State(_byMatricule)" class="@(_byMatricule ? "on" : "")" @onclick="() => Switch(true)">Avec mon matricule</button>
        </div>

        <Alert Message="@_error" />

        @if (_byMatricule)
        {
            <div class="ga-form-grid" style="grid-template-columns:repeat(2, minmax(0, 1fr))">
                <div class="ga-field">
                    <label for="login-school">Code de l'établissement</label>
                    <input id="login-school" class="ga-input big" style="text-transform:uppercase" autocomplete="organization" autocapitalize="characters" spellcheck="false"
                           placeholder="ex. LYCDEMO" required @bind="_school" @bind:event="oninput" />
                </div>
                <div class="ga-field">
                    <label for="login-matricule">Matricule</label>
                    <input id="login-matricule" class="ga-input big" autocomplete="username" autocapitalize="characters" spellcheck="false" required @bind="_matricule" @bind:event="oninput" />
                </div>
            </div>
            <div class="ga-field">
                <label for="login-mpassword">Mot de passe</label>
                <input id="login-mpassword" class="ga-input big" type="password" autocomplete="current-password" required @bind="_password" @bind:event="oninput" />
                <span class="ga-small ga-muted">Première connexion : le code imprimé sur ta fiche (GP-…). Tu choisiras ensuite ton mot de passe.</span>
            </div>
        }
        else
        {
            <div class="ga-field">
                <label for="login-email">Adresse e-mail ou nom d'utilisateur</label>
                <input id="login-email" class="ga-input big" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required @bind="_email" />
            </div>
            <div class="ga-field">
                <label for="login-password">Mot de passe</label>
                <input id="login-password" class="ga-input big" type="password" autocomplete="current-password" required @bind="_password" />
            </div>
        }

        <button type="submit" class="ga-btn big block" disabled="@_busy">@(_busy ? "Connexion…" : "Se connecter")</button>

        <hr class="ga-divider" />
        <p style="text-align:center; margin:0">Pas encore de compte ? <a href="/register" style="font-weight:600; text-decoration:none">Inscris-toi</a></p>
        <p style="text-align:center; margin:0">Ton établissement t'a donné un code ? <a href="/code" style="font-weight:600; text-decoration:none">J'ai un code</a></p>
        <p style="text-align:center; margin:0" class="ga-small"><a href="/">Retour au site de l'établissement</a></p>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "retour")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "matricule")] public string? MatriculeMode { get; set; }

    private string _email = "", _password = "", _school = "", _matricule = "";
    private string? _error;
    private bool _busy, _byMatricule;

    protected override async Task OnInitializedAsync()
    {
        _byMatricule = MatriculeMode is not null;
        await Session.RestoreAsync();
        if (Session.IsAuthenticated) Nav.NavigateTo(AppPage.SafeReturnUrl(ReturnUrl, Session.Role));
    }

    private void Switch(bool byMatricule)
    {
        _byMatricule = byMatricule;
        _error = null;
        _password = "";
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        var result = _byMatricule
            ? await Account.LoginMatriculeAsync(_school.Trim(), _matricule.Trim(), _password)
            : await Account.LoginAsync(_email.Trim(), _password);
        _busy = false;

        if (!result.Ok || result.Value is null)
        {
            _error = result.Status == System.Net.HttpStatusCode.Unauthorized
                ? (_byMatricule ? "Code d'établissement, matricule ou mot de passe incorrect." : "Identifiant ou mot de passe incorrect.")
                : result.Error;
            return;
        }
        await Session.SignInAsync(result.Value);
        var next = AppPage.SafeReturnUrl(ReturnUrl, Session.Role);
        // Connecté avec le code de sa fiche : il choisit d'abord son mot de passe
        Nav.NavigateTo(result.Value.Profile.MustChangePassword ? $"/app/mot-de-passe?retour={Uri.EscapeDataString(next)}" : next);
    }
}
