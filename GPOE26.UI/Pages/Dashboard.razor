@page "/app"
@layout AppLayout
@inherits AppPage

<PageTitle>Mon espace — GPOE26</PageTitle>

@if (!Ready)
{
    <div class="ga-page"><Loading /></div>
}
else
{
    @if (Session.IsFamilyGuardian)
    {
        <ParentHome />
    }
    else if (Session.CanTeach)
    {
        <TeacherHome />
    }
    else if (Session.CanLearn)
    {
        <StudentHome />
    }
    else if (Session.CanManageCourses)
    {
        <div class="ga-page">
            <section class="ga-card">
                <h1 class="ga-h1">Espace actif</h1>
                <p>Tu peux gérer les cours de cet espace depuis la rubrique « Mes cours ».</p>
            </section>
        </div>
    }
    else
    {
        <div class="ga-page">
            <Alert Message="Aucune capacité ne permet d'accéder aux pages de cet espace. Choisis un autre espace ou contacte son administrateur." />
        </div>
    }
}
