@page "/app/mot-de-passe"
@layout FocusLayout
@inherits AppPage
@inject IAccountApi Account

<PageTitle>Choisis ton mot de passe — GPOE26</PageTitle>

<div class="ob" style="background:#fff">
    <form class="ob-panel" style="justify-content:center; gap:20px; max-width:440px" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <div class="ob-title">
            <h1>Choisis ton mot de passe</h1>
            <p>Tu t'es connecté avec le code de ta fiche. Choisis maintenant un mot de passe à toi : c'est lui qui te servira ensuite, avec ton matricule.</p>
        </div>

        @if (Ready)
        {
            <div class="ga-card" style="background:var(--ga-blue-pale)">
                <span class="ga-small ga-muted">Ton nom d'utilisateur (il marche aussi pour te connecter)</span>
                <strong>@Me.Username</strong>
            </div>
        }

        <Alert Message="@_error" />

        <div class="ga-field">
            <label for="fp-new">Nouveau mot de passe (8 caractères au moins)</label>
            <input id="fp-new" class="ga-input big" type="password" autocomplete="new-password" @bind="_password" @bind:event="oninput" />
        </div>
        <div class="ga-field">
            <label for="fp-again">Encore une fois</label>
            <input id="fp-again" class="ga-input big" type="password" autocomplete="new-password" @bind="_again" @bind:event="oninput" />
        </div>
        <button type="submit" class="ga-btn big block" disabled="@_busy">@(_busy ? "Enregistrement…" : "Enregistrer")</button>
        @if (_password.Length >= 8 && _again.Length > 0 && _password != _again)
        {
            <span class="ga-small" style="text-align:center">Les deux mots de passe ne sont pas pareils.</span>
        }
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "retour")] public string? ReturnUrl { get; set; }

    private string _password = "", _again = "";
    private string? _error;
    private bool _busy;

    // Cette page est la seule ouverte tant que le mot de passe n'est pas choisi (AppPage)
    protected override bool AllowsPendingPassword => true;

    private async Task SaveAsync()
    {
        // Vérifié ici plutôt qu'en grisant le bouton : Entrée juste après la frappe envoie toujours le formulaire
        if (_password.Length < 8) { _error = "Le mot de passe doit contenir au moins 8 caractères."; return; }
        if (_password != _again) { _error = "Les deux mots de passe ne sont pas pareils."; return; }
        _busy = true;
        _error = null;
        var r = await Account.FirstPasswordAsync(_password);
        if (r.Ok && (await Account.MeAsync()).Value is { } profile) await Session.UpdateProfileAsync(profile);
        _busy = false;
        if (!r.Ok) { _error = r.Error; return; }
        Nav.NavigateTo(SafeReturnUrl(ReturnUrl, Session.Role));
    }
}
