@page "/app/cours/{Id:guid}"
@layout AppLayout
@inherits AppPage
@inject ICourseApi Courses
@inject IAssessmentApi Assessments
@inject IAgentApi Agent
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(_course?.Title ?? "Cours") — GPOE26</PageTitle>

@if (!Ready || _loading)
{
    <div class="ga-page"><Loading /></div>
}
else if (_course is null)
{
    <div class="ga-page"><Alert Message="@(_error ?? "Cours introuvable.")" /><a class="ga-back" href="/app/cours"><Icon Name="left" /> Mes cours</a></div>
}
else
{
    <div class="rd @(_tutorOpen ? "with-tutor" : "") @(_tocOpen ? "" : "no-toc")">
        <article class="rd-article" @ref="_article">
            <div class="rd-bar">
                <button type="button" class="ga-btn ghost small" aria-pressed="@Aria.State(_tocOpen)" @onclick="() => _tocOpen = !_tocOpen"><Icon Name="menu" /> Sommaire</button>
                @if (Session.HasFeature("tutor-ai"))
                {
                    <button type="button" class="ga-btn ghost small" aria-pressed="@Aria.State(_tutorOpen)" @onclick="() => _tutorOpen = !_tutorOpen"><Icon Name="spark" /> Tuteur IA</button>
                }
            </div>
            <nav aria-label="Fil d'Ariane" class="rd-meta"><a href="/app/cours" style="color:inherit">Mes cours</a> › @_course.Subject</nav>
            <h1>@_course.Title</h1>
            <div class="rd-meta">
                <span>@_course.Subject</span><span aria-hidden="true">·</span>
                <span>@ReadingMinutes min de lecture</span><span aria-hidden="true">·</span>
                <span>Mis à jour @Labels.Date(_course.UpdatedAt)</span>
            </div>

            @if (_toc.Count > 0)
            {
                <details class="rd-toc-mobile" open>
                    <summary>Sur cette page</summary>
                    @foreach (var t in _toc) { <a href="@($"{Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]}#{t.Id}")">@t.Title</a> }
                </details>
            }

            @if (_course.Description is { Length: > 0 })
            {
                <p style="font-size:19px; color:var(--ga-muted)">@_course.Description</p>
            }

            <Alert Message="@_error" />
            <Alert Message="@_info" Kind="success" />

            @if (_course.StructuringStatus == "Pending")
            {
                <div class="ga-alert" role="status" style="font-family:var(--ga-font)">L'agent met le cours en forme et cherche où un labo pourrait t'aider. Cela prend quelques minutes, tu peux déjà lire.</div>
            }
            else if (_course.OwnerId == Me.Id)
            {
                <LabSuggestionsPanel CourseId="_course.Id" Version="_analysisVersion" OnChanged="OnLabsChanged" />
            }

            @if (_course.SourceUrl is { Length: > 0 } source)
            {
                <p class="ga-small ga-muted" style="font-family:var(--ga-font)">Source : <a href="@source" target="_blank" rel="noopener noreferrer">@(new Uri(source).Host)</a></p>
            }

            @if (string.IsNullOrWhiteSpace(_html))
            {
                <div class="ga-empty" style="font-family:var(--ga-font)">
                    @if (_course.ContentType == CourseContentType.Pdf && _course.PdfPath is not null)
                    {
                        <span>Ce cours est un document PDF.</span>
                    }
                    else
                    {
                        <span>Ce cours n'a pas encore de contenu.</span>
                    }
                </div>
            }
            else
            {
                <div class="rd-content">@((MarkupString)_html)</div>
            }

            <div class="ga-row between" style="margin-top:28px; padding-top:18px; border-top:1px solid #ECEAE3; font-family:var(--ga-font)">
                <span class="ga-small ga-muted">Ce cours vous a-t-il été utile ?</span>
                <span class="ga-actions">
                    <button class="ga-btn small @(_vote == 1 ? "" : "secondary")" aria-pressed="@Aria.State(_vote == 1)" @onclick="() => _vote = 1">Oui</button>
                    <button class="ga-btn small @(_vote == -1 ? "" : "secondary")" aria-pressed="@Aria.State(_vote == -1)" @onclick="() => _vote = -1">Non</button>
                </span>
            </div>
        </article>

        <aside class="rd-side">
            @if (_toc.Count > 0)
            {
                <nav class="rd-toc" aria-labelledby="toc-title">
                    <h2 id="toc-title" style="font-size:14px; font-weight:700; margin:0 0 6px">Sur cette page</h2>
                    @foreach (var t in _toc)
                    {
                        <a class="@(t.Level == 3 ? "l3" : "")" href="@($"{Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]}#{t.Id}")">@t.Title</a>
                    }
                </nav>
            }

            <div class="ga-actions">
                <a class="ga-btn secondary small" href="/app/cours/@_course.Id/quiz"><Icon Name="check" /> S'entraîner</a>
                @if (_course.OwnerId == Me.Id)
                {
                    <a class="ga-btn ghost small" href="/app/cours/@_course.Id/modifier">Modifier</a>
                    @if (_course.ContentType == CourseContentType.Pdf)
                    {
                        <button type="button" class="ga-btn ghost small" disabled="@_restructuring" @onclick="RestructureAsync">@(_restructuring ? "Lecture du PDF…" : "Restructurer")</button>
                    }
                    else if (IsImported && _course.StructuringStatus != "Pending")
                    {
                        <button type="button" class="ga-btn ghost small" disabled="@_restructuring" @onclick="RestructureAsync">Relancer l'agent</button>
                    }
                }
            </div>

            @if (_related.Count > 0)
            {
                <div class="ga-card">
                    <h2 class="ga-h3">S'entraîner sur ce cours</h2>
                    @foreach (var a in _related)
                    {
                        <a class="ga-btn secondary small" href="/app/evaluations/@a.Id/composer">@a.Title</a>
                    }
                </div>
            }

            @if (Session.HasFeature("tutor-ai"))
            {
                <button class="ga-btn" @onclick="() => _tutorOpen = true"><Icon Name="chat" /> Demander au tuteur IA</button>
                <span class="ga-small ga-muted">Tes échanges avec le tuteur sont enregistrés : retrouve-les dans « Tuteur IA ».</span>
            }
            else
            {
                <a class="ga-premium-lock" href="/app/abonnement">
                    <Icon Name="chat" Size="24" />
                    <span><strong>Tuteur IA</strong><br /><span class="ga-small" style="color:#C9D3EA">Pose tes questions sur ce cours avec Premium.</span></span>
                </a>
                <a class="ga-btn ghost small" href="/app/tuteur/@_course.Id"><Icon Name="history" /> Relire mes discussions</a>
            }
        </aside>

        @if (_tutorOpen)
        {
            <div class="tu-drawer" aria-label="Tuteur IA">
                <TutorPanel CourseId="_course.Id" CourseTitle="@_course.Title" Docked="true" OnClose="() => _tutorOpen = false" />
            </div>
        }
    </div>

    @if (!_tutorOpen && Session.HasFeature("tutor-ai"))
    {
        <button class="ga-btn tu-fab" @onclick="() => _tutorOpen = true"><Icon Name="spark" /> Tuteur IA</button>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private string? _error, _info, _html;
    private CourseDetail? _course;
    private List<TocEntry> _toc = new();
    private List<StudentAssessment> _related = new();
    private int _vote;
    private bool _tutorOpen, _mathPending, _tocOpen = true, _restructuring;
    private CancellationTokenSource? _poll, _studyClock;
    private int _analysisVersion;
    private const int StudyTickMinutes = 2;
    private ElementReference _article;
    private IJSObjectReference? _module;

    private int ReadingMinutes => Math.Max(1, (_course?.ToMarkdown().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0) / 200);

    protected override async Task LoadAsync()
    {
        var result = await Courses.GetAsync(Id);
        _error = result.Error;
        Show(result.Value);

        // Évaluations d'entraînement ouvertes : proposées à l'élève à la fin du cours
        if (Session.Role == UserRole.Student)
        {
            StartStudyClock();
            var mine = await Assessments.MineAsStudentAsync();
            _related = (mine.Value ?? new()).Where(a => a.Kind == AssessmentKind.Practice && a.CanStart(DateTime.UtcNow)).Take(3).ToList();
        }
        _loading = false;
    }

    /// <summary>Temps réellement passé sur le cours : alimente le plan du jour et le tuteur.</summary>
    private void StartStudyClock()
    {
        _studyClock = new CancellationTokenSource();
        var token = _studyClock.Token;
        _ = InvokeAsync(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMinutes(StudyTickMinutes));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                    await Agent.RecordStudyAsync(Id, StudyTickMinutes);
            }
            catch (OperationCanceledException) { }
        });
    }

    private void Show(CourseDetail? course)
    {
        _course = course;
        if (_course is not null)
            (_html, _toc) = MarkdownRenderer.Render(_course.ToMarkdown());
        _mathPending = true;
        if (_course?.StructuringStatus == "Pending") StartPolling();
    }

    /// <summary>Le PDF est encore mis en forme par l'IA : la page se met à jour dès que c'est prêt.</summary>
    private void StartPolling()
    {
        if (_poll is not null) return;
        _poll = new CancellationTokenSource();
        var token = _poll.Token;
        _ = InvokeAsync(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    var latest = (await Courses.GetAsync(Id)).Value;
                    if (latest?.StructuringStatus == "Pending") continue;
                    _poll = null;
                    _analysisVersion++;
                    Show(latest);
                    StateHasChanged();
                    return;
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    private void OnLabsChanged((CourseDetail Course, string Message) change)
    {
        Show(change.Course);
        _error = null;
        _info = change.Message;
    }

    /// <summary>Cours importé par lien ou par photos : l'agent peut le relire (pages restées en photo, labos).</summary>
    private bool IsImported => _course is { } c && (c.SourceUrl is not null || c.ToMarkdown().Contains("(scan)](", StringComparison.Ordinal));

    private async Task RestructureAsync()
    {
        _restructuring = true;
        _error = _info = null;
        var result = await Courses.RestructureAsync(Id);
        _restructuring = false;
        if (result.Value is null) { _error = result.Error ?? "Le cours n'a pas pu être relu."; return; }
        _analysisVersion++;
        Show(result.Value);

        if (result.Value.ContentType != CourseContentType.Pdf)
        {
            _info = "L'agent relit le cours : les pages restées en photo seront retranscrites et des labos proposés si le sujet s'y prête.";
            return;
        }

        var markdown = result.Value.ToMarkdown();
        var figures = System.Text.RegularExpressions.Regex.Count(markdown, @"!\[");
        var formulas = System.Text.RegularExpressions.Regex.Count(markdown, @"\$\$") / 2;
        _info = $"PDF relu : {figures} schéma(s) et {formulas} formule(s) détachée(s) reconstruits."
            + (result.Value.StructuringStatus == "Pending" ? " L'IA affine encore le texte." : "");
    }

    /// <summary>Formules KaTeX et coloration du code, une fois le cours affiché</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_mathPending || _course is null || _loading) return;
        _mathPending = false;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GPOE26.UI/gpoe-app.js");
            await _module.InvokeVoidAsync("renderMath", _article);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _poll?.Cancel();
        _studyClock?.Cancel();
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
