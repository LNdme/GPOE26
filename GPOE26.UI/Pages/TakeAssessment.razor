@page "/app/evaluations/{Id:guid}/composer"
@layout FocusLayout
@inherits AppPage
@implements IDisposable
@inject IAssessmentApi Api
@inject IAccountApi Account

<PageTitle>@(_attempt?.Title ?? "Évaluation") — GPOE26</PageTitle>

@if (!Ready || _loading)
{
    <div class="ga-page narrow"><Loading Text="Préparation de ta copie…" /></div>
}
else if (_attempt is null)
{
    <div class="ga-page narrow">
        <Alert Message="@_error" />
        <a class="ga-back" href="/app/evaluations"><Icon Name="left" /> Mes évaluations</a>
    </div>
}
else if (_result is not null)
{
    <div class="ga-page narrow">
        <div class="ga-card" style="flex-direction:row; flex-wrap:wrap; align-items:center; gap:24px; padding:28px">
            <div class="ga-stat" style="width:130px; height:130px; border-radius:999px; align-items:center; justify-content:center">
                @if (_result.ResultsReleased && _result.ScoreScaled is not null)
                {
                    <span class="val">@Labels.Number(_result.ScoreScaled.Value)</span><span class="sub">sur @_result.ScaleTo</span>
                }
                else
                {
                    <Icon Name="tick" Size="44" Stroke="2.2" />
                }
            </div>
            <div class="ga-stack" style="flex:1 1 260px; gap:8px">
                <h1 class="ga-h1" style="font-size:30px">@ResultTitle</h1>
                <p class="ga-muted" style="margin:0">@ResultText</p>
                @if (_result.IsLate) { <span class="ga-tag amber" style="align-self:flex-start">RENDUE EN RETARD</span> }
            </div>
        </div>
        <div class="ga-actions">
            <a class="ga-btn" href="/app/evaluations/@Id/copies/@_result.SubmissionId">Voir ma copie</a>
            <a class="ga-btn secondary" href="/app">Retour au plan d'études</a>
        </div>
    </div>
}
else
{
    var q = _attempt.Questions[_current];
    var answer = _answers[q.Id];
    <header class="ex-head">
        <a class="ga-icon-btn" href="/app/evaluations" aria-label="Quitter (ta tentative reste ouverte)" title="Quitter (ta tentative reste ouverte)"><Icon Name="x" Size="22" /></a>
        <div class="grow">
            <strong>@_attempt.Title</strong><br />
            <span class="ga-small ga-muted">Tentative @_attempt.AttemptNumber · @Answered / @_attempt.Questions.Count réponses</span>
            @if (_draftStatus is not null)
            {
                <br /><span class="ga-small @(_draftFailed ? "" : "ga-muted")" role="status" style="@(_draftFailed ? "color:var(--ga-amber-ink)" : null)">@_draftStatus</span>
            }
        </div>
        <div class="ex-progress" role="progressbar" aria-label="Questions répondues" aria-valuenow="@Answered" aria-valuemin="0" aria-valuemax="@_attempt.Questions.Count">
            <span style="width:@(Answered * 100 / Math.Max(1, _attempt.Questions.Count))%"></span>
        </div>
        @if (_attempt.Deadline is not null)
        {
            <span class="ex-timer" role="timer" aria-live="off" title="Temps restant">@Remaining</span>
        }
        <button class="ga-btn small" @onclick="AskSubmit">Rendre ma copie</button>
    </header>

    <div class="ga-page narrow">
        <Alert Message="@_error" />

        @if (_confirm)
        {
            <div class="ga-alert warn ga-stack" role="alertdialog" aria-label="Confirmer l'envoi">
                <strong>@(Unanswered > 0 ? $"Il reste {Unanswered} question(s) sans réponse." : "Prêt à rendre ta copie ?")</strong>
                <span>Une fois rendue, ta copie ne peut plus être modifiée.</span>
                <div class="ga-row">
                    <button class="ga-btn" disabled="@_busy" @onclick="SubmitAsync">@(_busy ? "Envoi…" : "Oui, rendre ma copie")</button>
                    <button class="ga-btn secondary" @onclick="() => _confirm = false">Continuer à composer</button>
                </div>
            </div>
        }

        <nav class="ex-dots" aria-label="Aller à une question">
            @for (var i = 0; i < _attempt.Questions.Count; i++)
            {
                var index = i;
                var answered = IsAnswered(_attempt.Questions[index]);
                var css = (answered ? "answered " : "") + (index == _current ? "current" : "");
                var label = $"Question {index + 1}" + (answered ? ", répondue" : "");
                <button class="@css" aria-label="@label" aria-current="@Aria.Current(index == _current)" @onclick="() => _current = index">@(index + 1)</button>
            }
        </nav>

        <section class="ex-q" aria-labelledby="q-title">
            <span class="ga-kbd ga-small ga-muted">QUESTION @(_current + 1) SUR @_attempt.Questions.Count · @Labels.Number(q.Points) POINT(S) · @Labels.Of(q.Type).ToUpperInvariant()</span>
            <h2 id="q-title">@q.Text</h2>

            @switch (q.Type)
            {
                case QuestionType.SingleChoice:
                case QuestionType.MultipleChoice:
                    @if (q.Type == QuestionType.MultipleChoice) { <span class="ga-small ga-muted">Plusieurs réponses possibles.</span> }
                    <div class="ga-stack" role="group" aria-labelledby="q-title">
                        @for (var i = 0; i < q.Options.Count; i++)
                        {
                            var opt = q.Options[i];
                            var on = answer.SelectedOptions.Contains(opt.Index);
                            <button type="button" class="ex-opt @(on ? "on" : "")" aria-pressed="@Aria.State(on)" @onclick="() => Choose(q, answer, opt.Index)">
                                <span class="letter">@((char)('A' + i))</span><span>@opt.Text</span>
                            </button>
                        }
                    </div>
                    break;

                case QuestionType.TrueFalse:
                    <div class="ga-grid tight" role="group" aria-labelledby="q-title">
                        <button type="button" class="ex-opt @(answer.TrueFalse == true ? "on" : "")" aria-pressed="@Aria.State(answer.TrueFalse == true)" @onclick="() => answer.TrueFalse = true"><span class="letter">V</span>Vrai</button>
                        <button type="button" class="ex-opt @(answer.TrueFalse == false ? "on" : "")" aria-pressed="@Aria.State(answer.TrueFalse == false)" @onclick="() => answer.TrueFalse = false"><span class="letter">F</span>Faux</button>
                    </div>
                    break;

                case QuestionType.ShortAnswer:
                case QuestionType.Numeric:
                    <div class="ga-field">
                        <label for="ans-text">Ta réponse@(q.Unit is { Length: > 0 } ? $" (en {q.Unit})" : "")</label>
                        <input id="ans-text" class="ga-input big" inputmode="@(q.Type == QuestionType.Numeric ? "decimal" : "text")" autocomplete="off"
                               @bind="answer.Text" @bind:event="oninput" />
                        @if (q.Type == QuestionType.Numeric) { <span class="help">Tu peux utiliser la virgule ou le point.</span> }
                    </div>
                    break;

                case QuestionType.OpenEnded:
                    var photos = _photos.GetValueOrDefault(q.Id) ?? [];
                    <div class="ga-field">
                        <label for="ans-open">Ta réponse rédigée</label>
                        <textarea id="ans-open" class="ga-textarea" rows="@(photos.Count > 0 ? 4 : 9)" @bind="answer.Text" @bind:event="oninput"
                                  placeholder="Rédige ici, ou traite la question sur papier et photographie ta copie."></textarea>
                        <span class="help">Ton enseignant corrige cette question. Calculs longs (maths, physique…) : traite-les sur papier et joins une photo par page.</span>
                    </div>
                    <div class="ga-card sunk" style="padding:14px; gap:10px">
                        <div class="ga-row between">
                            <strong><Icon Name="camera" Size="18" /> Copie sur papier</strong>
                            <span class="ga-small ga-muted">@photos.Count / 4 page(s)</span>
                        </div>
                        <CopyPhotos AssessmentId="Id" SubmissionId="_attempt.SubmissionId" Photos="photos" Disabled="_uploading"
                                    OnDelete="p => DeletePhotoAsync(q, p)" OpenTranscription="true" />
                        @if (_uploading)
                        {
                            <Loading Text="Envoi de ta photo…" />
                        }
                        else if (photos.Count < 4)
                        {
                            <PhotoPicker Label="@(photos.Count == 0 ? "Photographier ma copie" : "Ajouter une page")" Css="secondary small"
                                         OnPicked="p => UploadPhotoAsync(q, p)" OnError="e => _error = e" />
                            <span class="ga-small ga-muted">Pose ta feuille à plat, bien éclairée. L'IA la lit pendant que tu continues : vérifie ensuite ce qu'elle a lu, et reprends la photo si c'est flou.</span>
                        }
                    </div>
                    break;
            }

            <div class="ga-row between" style="margin-top:6px">
                <button class="ga-btn secondary" disabled="@(_current == 0)" @onclick="() => _current--"><Icon Name="left" /> Précédente</button>
                @if (_current < _attempt.Questions.Count - 1)
                {
                    <button class="ga-btn" @onclick="() => _current++">Suivante <Icon Name="right" /></button>
                }
                else
                {
                    <button class="ga-btn" @onclick="AskSubmit">Rendre ma copie</button>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    protected override UserRole[]? AllowedRoles => [UserRole.Student];

    private bool _loading = true, _busy, _confirm;
    private string? _error;
    private Attempt? _attempt;
    private SubmissionReview? _result;
    private int _current;
    private readonly Dictionary<Guid, AnswerDraft> _answers = new();
    private readonly Dictionary<Guid, List<AnswerPhoto>> _photos = new();
    private bool _uploading;
    private Timer? _timer;

    // Brouillon : les réponses sont enregistrées côté serveur pendant la composition.
    // Une coupure de réseau, un rechargement ou une fermeture d'onglet ne fait plus perdre la copie.
    private static readonly TimeSpan DraftInterval = TimeSpan.FromSeconds(5);
    private CancellationTokenSource? _draftLoop;
    private string _savedDraft = "";
    private string? _draftStatus;
    private bool _draftFailed;

    private int Answered => _attempt?.Questions.Count(IsAnswered) ?? 0;
    private int Unanswered => (_attempt?.Questions.Count ?? 0) - Answered;

    private bool IsAnswered(AttemptQuestion q) => _answers.TryGetValue(q.Id, out var a) && q.Type switch
    {
        QuestionType.SingleChoice or QuestionType.MultipleChoice => a.SelectedOptions.Count > 0,
        QuestionType.TrueFalse => a.TrueFalse is not null,
        QuestionType.OpenEnded => !string.IsNullOrWhiteSpace(a.Text) || _photos.GetValueOrDefault(q.Id) is { Count: > 0 },
        _ => !string.IsNullOrWhiteSpace(a.Text)
    };

    private string Remaining
    {
        get
        {
            var left = _attempt!.Deadline!.Value - DateTime.UtcNow;
            if (left <= TimeSpan.Zero) return "Temps écoulé";
            return left.TotalHours >= 1 ? $"{(int)left.TotalHours} h {left.Minutes:00}" : $"{left.Minutes:00}:{left.Seconds:00}";
        }
    }

    protected override async Task LoadAsync()
    {
        var result = await Api.StartAttemptAsync(Id);
        _attempt = result.Value;
        _error = result.Error;
        if (_attempt is not null)
        {
            foreach (var q in _attempt.Questions) _answers[q.Id] = new AnswerDraft { QuestionId = q.Id };
            // Tentative reprise : les réponses déjà saisies sont retrouvées
            var restored = 0;
            foreach (var saved in _attempt.Draft ?? [])
            {
                if (!_answers.TryGetValue(saved.QuestionId, out var answer)) continue;
                answer.SelectedOptions = saved.SelectedOptions ?? [];
                answer.TrueFalse = saved.TrueFalse;
                answer.Text = saved.Text;
                restored++;
            }
            _savedDraft = Snapshot();
            if (restored > 0 && Answered > 0) _draftStatus = "Tes réponses ont été retrouvées.";
            StartDraftLoop();
            // Tentative reprise : les photos déjà envoyées sont conservées
            foreach (var group in (_attempt.Photos ?? []).GroupBy(p => p.QuestionId))
                _photos[group.Key] = group.OrderBy(p => p.Page).ToList();
            if (_attempt.Deadline is not null)
                _timer = new Timer(_ => InvokeAsync(TickAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
        _loading = false;
    }

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(_answers.Values);

    /// <summary>
    /// Toutes les quelques secondes : enregistre le brouillon s'il a changé, et prolonge la session
    /// (on peut réfléchir longtemps sans rien envoyer). Un échec est signalé puis retenté au tour suivant.
    /// </summary>
    private void StartDraftLoop()
    {
        _draftLoop = new CancellationTokenSource();
        var token = _draftLoop.Token;
        _ = InvokeAsync(async () =>
        {
            using var timer = new PeriodicTimer(DraftInterval);
            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    if (_result is not null) return;
                    await Account.KeepSessionAliveAsync();
                    if (!_busy) await SaveDraftAsync();
                    if (!_busy) await RefreshPendingPhotosAsync();
                }
            }
            catch (OperationCanceledException) { }
        });
    }

    /// <summary>Lecture des photos par l'IA, faite en arrière-plan : la page la récupère dès qu'elle est prête.</summary>
    private async Task RefreshPendingPhotosAsync()
    {
        if (_attempt is null || !_photos.Values.Any(list => list.Any(p => p.Pending))) return;
        var result = await Api.AttemptPhotosAsync(Id, _attempt.SubmissionId);
        if (result.Value is not { } photos || _result is not null) return;

        _photos.Clear();
        foreach (var group in photos.GroupBy(p => p.QuestionId))
            _photos[group.Key] = group.OrderBy(p => p.Page).ToList();
        StateHasChanged();
    }

    private async Task SaveDraftAsync()
    {
        var snapshot = Snapshot();
        if (snapshot == _savedDraft || _attempt is null) return;

        var result = await Api.SaveDraftAsync(Id, _attempt.SubmissionId, _answers.Values.ToList());
        if (_result is not null) return;   // la copie a été rendue entre-temps
        _draftFailed = !result.Ok;
        if (result.Ok)
        {
            _savedDraft = snapshot;
            _draftStatus = $"Brouillon enregistré à {AppTime.Now:HH:mm}";
        }
        else if (result.Status == System.Net.HttpStatusCode.Conflict)
        {
            // La copie a déjà été rendue (depuis un autre onglet, par exemple) : inutile d'insister
            _draftStatus = result.Error;
            _draftLoop?.Cancel();
        }
        else
        {
            _draftStatus = "Brouillon non enregistré : vérifie ta connexion. Nouvel essai dans quelques secondes.";
        }
        StateHasChanged();
    }

    private async Task TickAsync()
    {
        if (_attempt?.Deadline is { } deadline && DateTime.UtcNow >= deadline && _result is null && !_busy)
        {
            // Temps écoulé : la copie est rendue automatiquement pour ne rien perdre
            _timer?.Dispose();
            _error = "Le temps est écoulé : ta copie a été rendue automatiquement.";
            await SubmitAsync();
        }
        StateHasChanged();
    }

    private static void Choose(AttemptQuestion q, AnswerDraft a, int index)
    {
        if (q.Type == QuestionType.SingleChoice) a.SelectedOptions = [index];
        else if (!a.SelectedOptions.Remove(index)) a.SelectedOptions.Add(index);
    }

    private void AskSubmit() => _confirm = true;

    private async Task UploadPhotoAsync(AttemptQuestion q, ImageUpload photo)
    {
        _uploading = true; _error = null;
        StateHasChanged();
        var result = await Api.UploadPhotoAsync(Id, _attempt!.SubmissionId, q.Id, photo);
        _uploading = false;
        if (!result.Ok) { _error = result.Error; return; }
        if (!_photos.TryGetValue(q.Id, out var list)) _photos[q.Id] = list = new();
        list.Add(result.Value!);
    }

    private async Task DeletePhotoAsync(AttemptQuestion q, AnswerPhoto photo)
    {
        var result = await Api.DeletePhotoAsync(Id, _attempt!.SubmissionId, photo.Id);
        if (!result.Ok) { _error = result.Error; return; }
        var list = _photos[q.Id];
        list.Remove(photo);
        for (var i = 0; i < list.Count; i++) list[i] = list[i] with { Page = i + 1 };
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        var result = await Api.SubmitAsync(Id, _attempt!.SubmissionId, _answers.Values.ToList());
        _busy = false;
        _confirm = false;
        if (!result.Ok) { _error = result.Error; return; }
        _timer?.Dispose();
        _draftLoop?.Cancel();
        _result = result.Value;
    }

    private string ResultTitle => _result!.ResultsReleased && _result.ScoreScaled is not null
        ? _result.ScoreScaled >= _result.ScaleTo * 0.75m ? "Excellent travail !" : _result.ScoreScaled >= _result.ScaleTo / 2m ? "Bien joué !" : "Continue tes efforts"
        : "Copie rendue";

    private string ResultText => _result!.Status == SubmissionStatus.Submitted
        ? "Ton enseignant doit encore corriger les réponses rédigées. Tu verras ta note dans « Mes évaluations »."
        : _result.ResultsReleased
            ? "Consulte ta copie pour voir la correction de chaque question."
            : "Ta note et la correction seront visibles après la date limite.";

    public void Dispose()
    {
        _timer?.Dispose();
        _draftLoop?.Cancel();
        _draftLoop?.Dispose();
    }
}
