@page "/app/cours/{Id:guid}/quiz"
@layout AppLayout
@inherits AppPage
@inject ICourseApi Courses
@inject IPracticeQuizApi Quizzes
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>S'entraîner — GPOE26</PageTitle>

<div class="ga-page narrow" @ref="_root">
    <a class="ga-back" href="/app/cours/@Id"><Icon Name="left" /> Retour au cours</a>
    <Alert Message="@_error" />

    @if (!Ready || _loading)
    {
        <Loading />
    }
    else if (_course is null)
    {
        <Alert Message="Cours introuvable." />
    }
    else if (_generating)
    {
        <div class="ga-card"><Loading Text="Préparation des exercices à partir du cours…" /></div>
    }
    else if (_problems is not null)
    {
        <div class="ga-head"><div><h1>Série d'exercices</h1><p>@_course.Title · @DifficultyLabel</p></div></div>
        @foreach (var (problem, index) in _problems.Problems.Select((p, i) => (p, i)))
        {
            var shown = _shownHints.GetValueOrDefault(index);
            <section class="ga-card">
                <span class="ga-tag grey" style="align-self:flex-start">EXERCICE @(index + 1)</span>
                <div class="rd-content qz-text">@Md(problem.Statement)</div>
                @for (var h = 0; h < shown && h < problem.Hints.Count; h++)
                {
                    <div class="ga-alert"><strong>Indice @(h + 1).</strong> <span class="rd-content qz-text">@Md(problem.Hints[h])</span></div>
                }
                @if (_solutions.Contains(index))
                {
                    <div class="qz-solution">
                        <span class="ga-label">Solution détaillée</span>
                        <div class="rd-content qz-text">@Md(problem.Solution)</div>
                    </div>
                }
                <div class="ga-actions">
                    @if (shown < problem.Hints.Count)
                    {
                        <button class="ga-btn secondary small" @onclick="() => _shownHints[index] = shown + 1">Voir un indice</button>
                    }
                    @if (!_solutions.Contains(index))
                    {
                        <button class="ga-btn ghost small" @onclick="() => _solutions.Add(index)">Afficher la solution</button>
                    }
                </div>
            </section>
        }
        <button class="ga-btn secondary" style="align-self:flex-start" @onclick="Reset">Nouvelle série</button>
    }
    else if (_quiz is null)
    {
        <div class="ga-head"><div><h1>S'entraîner sur ce cours</h1><p>@_course.Title</p></div></div>
        <section class="ga-card">
            @if (string.IsNullOrWhiteSpace(_course.ExtractedText))
            {
                <div class="ga-alert warn">Le contenu du cours est nécessaire pour créer des exercices.</div>
            }
            <div class="ga-tabs" role="tablist" aria-label="Type d'entraînement">
                <button role="tab" class="@(_problemMode ? "" : "on")" aria-selected="@Aria.State(!_problemMode)" @onclick="() => _problemMode = false">Quiz à choix multiples</button>
                <button role="tab" class="@(_problemMode ? "on" : "")" aria-selected="@Aria.State(_problemMode)" @onclick="() => _problemMode = true">Série d'exercices corrigés</button>
            </div>
            <div class="ga-field">
                <label for="qz-level">Niveau d'exigence</label>
                <select id="qz-level" class="ga-select" @bind="_difficulty">
                    <option value="standard">Standard : applications directes</option>
                    <option value="approfondi">Approfondi : raisonnement en plusieurs étapes</option>
                    <option value="exigeant">Exigeant : niveau universitaire, cas limites et démonstrations</option>
                </select>
            </div>
            <div class="ga-field">
                <label for="qz-count">@(_problemMode ? "Nombre d'exercices" : "Nombre de questions")</label>
                <select id="qz-count" class="ga-select" @bind="_count">
                    @foreach (var n in _problemMode ? new[] { 1, 2, 3, 5 } : new[] { 3, 5, 10 })
                    {
                        <option value="@n">@n</option>
                    }
                </select>
            </div>
            <button class="ga-btn" disabled="@string.IsNullOrWhiteSpace(_course.ExtractedText)" @onclick="GenerateAsync"><Icon Name="spark" /> Générer</button>
        </section>
    }
    else if (_result is null)
    {
        var current = _quiz.Questions[_index];
        <div class="ga-head">
            <div><h1>@_quiz.Title</h1><p>Question @(_index + 1) sur @_quiz.Questions.Count</p></div>
        </div>
        <div class="qz-progress" role="progressbar" aria-label="Progression du quiz" aria-valuenow="@(_index + 1)" aria-valuemin="1" aria-valuemax="@_quiz.Questions.Count">
            <span style="width:@($"{100.0 * (_index + 1) / _quiz.Questions.Count:0.##}".Replace(',', '.'))%"></span>
        </div>
        <section class="ga-card">
            <div class="rd-content qz-text ga-h2">@Md(current.Text)</div>
            <div class="qz-options" role="group" aria-label="Choisissez une réponse">
                @for (var i = 0; i < current.Options.Count; i++)
                {
                    var option = i;
                    var selected = _answers.TryGetValue(current.Id, out var answer) && answer == option;
                    <button type="button" class="qz-option @(selected ? "on" : "")" aria-pressed="@Aria.State(selected)" @onclick="() => _answers[current.Id] = option">
                        <span class="qz-letter">@((char)('A' + option))</span>
                        <span class="rd-content qz-text">@Md(current.Options[option])</span>
                    </button>
                }
            </div>
            <div class="ga-row between">
                <button class="ga-btn secondary" disabled="@(_index == 0)" @onclick="() => _index--">Précédente</button>
                @if (_index < _quiz.Questions.Count - 1)
                {
                    <button class="ga-btn" @onclick="() => _index++">Question suivante</button>
                }
                else
                {
                    <button class="ga-btn" disabled="@(_submitting || _answers.Count < _quiz.Questions.Count)" @onclick="SubmitAsync">@(_submitting ? "Correction…" : "Terminer le quiz")</button>
                }
            </div>
            <span class="ga-small ga-muted" aria-live="polite">@_answers.Count sur @_quiz.Questions.Count réponses</span>
        </section>
    }
    else
    {
        <section class="ga-card dark">
            <span class="ga-tag lime" style="align-self:flex-start">VOTRE BILAN</span>
            <h1 class="ga-h1" style="color:#fff">@_result.Score / @_result.Total</h1>
            <span>@_result.Percentage.ToString("F0") % de bonnes réponses</span>
        </section>
        <div class="ga-list">
            @foreach (var f in _result.Feedbacks)
            {
                <article class="ga-card">
                    <span class="ga-tag @(f.IsCorrect ? "green" : "amber")" style="align-self:flex-start">@(f.IsCorrect ? "RÉPONSE JUSTE" : "À REVOIR")</span>
                    <div class="rd-content qz-text ga-h3">@Md(f.QuestionText)</div>
                    @if (!f.IsCorrect)
                    {
                        <span class="ga-small">Votre réponse : @((char)('A' + f.SelectedOptionIndex)) · Bonne réponse : <strong>@((char)('A' + f.CorrectOptionIndex))</strong></span>
                    }
                    <div class="rd-content qz-text ga-muted">@Md(f.Explanation)</div>
                </article>
            }
        </div>
        <div class="ga-actions">
            <button class="ga-btn secondary" @onclick="Reset">Refaire un quiz</button>
            <a class="ga-btn" href="/app/cours/@Id">Retour au cours</a>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private CourseDetail? _course;
    private PracticeQuiz? _quiz;
    private PracticeResult? _result;
    private PracticeProblemSet? _problems;
    private readonly Dictionary<Guid, int> _answers = new();
    private readonly Dictionary<int, int> _shownHints = new();
    private readonly HashSet<int> _solutions = new();
    private bool _loading = true, _generating, _submitting, _problemMode;
    private int _count = 5, _index;
    private string _difficulty = "standard";
    private string? _error;
    private ElementReference _root;
    private IJSObjectReference? _module;

    private string DifficultyLabel => _difficulty switch
    {
        "exigeant" => "niveau exigeant",
        "approfondi" => "niveau approfondi",
        _ => "niveau standard"
    };

    private static MarkupString Md(string text) => new(MarkdownRenderer.Render(text).Html);

    protected override async Task LoadAsync()
    {
        // Un étudiant arrive directement sur le niveau qui lui correspond
        if (Me.Stage == EducationStage.Higher) _difficulty = "exigeant";

        var result = await Courses.GetAsync(Id);
        _course = result.Value;
        _error = result.Error;
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_quiz is null && _problems is null) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/GPOE26.UI/gpoe-app.js");
            await _module.InvokeVoidAsync("renderMath", _root);
        }
        catch (JSDisconnectedException) { }
    }

    private async Task GenerateAsync()
    {
        _generating = true;
        _error = null;

        if (_problemMode)
        {
            var problems = await Quizzes.GenerateProblemsAsync(_course!.Title, _course.ExtractedText!, Math.Min(_count, 5), _difficulty);
            _generating = false;
            if (problems.Value is not { Problems.Count: > 0 })
            {
                _error = problems.Error ?? "Les exercices n'ont pas pu être préparés. Réessayez.";
                return;
            }
            _problems = problems.Value;
            return;
        }

        var result = await Quizzes.GenerateAsync(_course!.Title, _course.ExtractedText!, _count, _difficulty);
        _generating = false;
        if (result.Value is not { Questions.Count: > 0 })
        {
            _error = result.Error ?? "Le quiz n'a pas pu être généré. Réessayez.";
            return;
        }
        _quiz = result.Value;
        _index = 0;
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        var result = await Quizzes.SubmitAsync(_quiz!.QuizId, _answers.Select(a => new PracticeAnswer(a.Key, a.Value)).ToList());
        _submitting = false;
        _result = result.Value;
        _error = result.Error;
    }

    private void Reset()
    {
        _quiz = null;
        _result = null;
        _problems = null;
        _answers.Clear();
        _shownHints.Clear();
        _solutions.Clear();
        _error = null;
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
