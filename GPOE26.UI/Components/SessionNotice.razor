@implements IAsyncDisposable
@inject SessionState Session
@inject IAccountApi Account
@inject NavigationManager Nav
@inject IJSRuntime JS

@* Garde la session ouverte tant que l'utilisateur est devant l'écran, même sans rien envoyer
   (un cours rédigé pendant une heure, une longue lecture), et prévient avant qu'elle se termine. *@
@if (_state == NoticeState.Ending)
{
    <div class="gpoe-session-notice" role="status">
        <span>Votre session se termine dans @MinutesLeft. @(_renewFailed ? "Elle ne peut plus être prolongée : enregistrez votre travail, puis reconnectez-vous." : "")</span>
        @if (!_renewFailed)
        {
            <button type="button" class="ga-btn small" disabled="@_busy" @onclick="StayAsync">Rester connecté</button>
        }
    </div>
}
else if (_state == NoticeState.Ended)
{
    <div class="gpoe-session-notice is-ended" role="alert">
        <span>Votre session est terminée. Ce qui n'a pas été enregistré reste affiché : copiez-le si besoin, puis reconnectez-vous.</span>
        <a class="ga-btn small" href="@LoginHref">Se reconnecter</a>
    </div>
}

@code {
    /// <summary>Le bandeau apparaît quand il reste moins que ce délai.</summary>
    public static readonly TimeSpan WarnBefore = TimeSpan.FromMinutes(5);

    /// <summary>Une action dans ce délai compte comme « devant l'écran » : la session est alors prolongée sans rien demander.</summary>
    public static readonly TimeSpan ActiveWindow = TimeSpan.FromMinutes(5);

    private static readonly TimeSpan CheckEvery = TimeSpan.FromSeconds(30);

    public enum NoticeState { Hidden, Ending, Ended }

    private NoticeState _state;
    private bool _busy, _renewFailed;
    private PeriodicTimer? _timer;
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _cts = new();

    /// <summary>Ce que le bandeau doit montrer, selon le temps restant (règle testée à part).</summary>
    public static NoticeState StateFor(bool signedIn, DateTime expiresAt, DateTime now) =>
        !signedIn ? NoticeState.Hidden
        : now >= expiresAt ? NoticeState.Ended
        : expiresAt - now <= WarnBefore ? NoticeState.Ending
        : NoticeState.Hidden;

    private string MinutesLeft
    {
        get
        {
            var minutes = (int)Math.Ceiling((Session.ExpiresAt - DateTime.UtcNow).TotalMinutes);
            return minutes <= 1 ? "moins d'une minute" : $"{minutes} minutes";
        }
    }

    private string LoginHref => "/login?retour=" + Uri.EscapeDataString("/" + Nav.ToBaseRelativePath(Nav.Uri));

    protected override void OnInitialized()
    {
        _timer = new PeriodicTimer(CheckEvery);
        _ = LoopAsync();
    }

    private async Task LoopAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
                await InvokeAsync(CheckAsync);
        }
        catch (OperationCanceledException) { }
    }

    private async Task CheckAsync()
    {
        // Utilisateur actif et jeton entamé : on le renouvelle sans bandeau
        if (Session.ShouldRenew && await IsActiveAsync())
            await Account.KeepSessionAliveAsync();

        var state = StateFor(Session.Token is not null, Session.ExpiresAt, DateTime.UtcNow);
        if (state == NoticeState.Hidden) _renewFailed = false;
        if (state != _state || state == NoticeState.Ending)
        {
            _state = state;
            StateHasChanged();
        }
    }

    private async Task<bool> IsActiveAsync()
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", _cts.Token, "./_content/GPOE26.UI/gpoe-app.js");
            return await _module.InvokeAsync<bool>("activeWithin", _cts.Token, (int)ActiveWindow.TotalMilliseconds);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException or InvalidOperationException)
        {
            return false;
        }
    }

    private async Task StayAsync()
    {
        _busy = true;
        var before = Session.ExpiresAt;
        await Account.KeepSessionAliveAsync();
        // Le service des comptes refuse au-delà de 12 h depuis la connexion : il faut alors se reconnecter
        _renewFailed = Session.ExpiresAt <= before;
        _state = StateFor(Session.Token is not null, Session.ExpiresAt, DateTime.UtcNow);
        _busy = false;
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
        _cts.Dispose();
    }
}
