@if (!string.IsNullOrWhiteSpace(Message))
{
    <div class="ga-alert @Kind" role="@(Kind == "error" ? "alert" : "status")">@Message</div>
}

@code {
    [Parameter] public string? Message { get; set; }
    /// <summary>error, success, warn ou vide (information)</summary>
    [Parameter] public string Kind { get; set; } = "error";
}
