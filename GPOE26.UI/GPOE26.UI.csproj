<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Interface de l'espace d'apprentissage (élèves, enseignants, parents).
    Volontairement sans dépendance à ASP.NET Core côté serveur : la même bibliothèque
    sera hébergée par GPOE26.Web (Blazor Server) et par l'application Windows (MAUI Blazor Hybrid).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

</Project>
