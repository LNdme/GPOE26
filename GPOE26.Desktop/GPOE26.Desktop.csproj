<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Application Windows de GPOE26 (phase 4) : .NET MAUI Blazor Hybrid.
    Elle affiche les mêmes écrans que le site (bibliothèque GPOE26.UI) et fonctionne hors connexion
    grâce à GPOE26.Offline (cache SQLite, composition sans réseau, synchronisation au retour du réseau).
    Compilation : Windows uniquement (Visual Studio 2026 avec la charge MAUI, ou « dotnet workload install maui-windows »).
    Le workflow GitHub « Application Windows » la compile et publie l'exécutable.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GPOE26.Desktop</RootNamespace>
    <AssemblyName>GPOE26</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>

    <ApplicationTitle>GPOE26</ApplicationTitle>
    <ApplicationId>cm.gpoe26.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Application non empaquetée (simple dossier ou installateur), sans Microsoft Store -->
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0E2350" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0E2350" BaseSize="128,128" />
    <EmbeddedResource Include="appsettings.json" LogicalName="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GPOE26.UI\GPOE26.UI.csproj" />
    <ProjectReference Include="..\GPOE26.Offline\GPOE26.Offline.csproj" />
  </ItemGroup>

</Project>
