{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Key": "votre_cle_secrete_tres_longue_et_aleatoire_ici_changez_moi_en_production_cle_256_bits",
    "Issuer": "GPOE2026",
    "Audience": "GPOE2026Users",
    "ExpirationMinutes": 60
  },

  // ⚠️ Aucune clé d'API ici. OpenRouter__ApiKey est injectée par l'AppHost, depuis le
  // paramètre secret « openrouter-api-key » (user-secrets de GPOE26.AppHost).
  //
  // Le service Cours utilise trois de ces modèles :
  //   Vision        → transcription des photos de cours (doit accepter les images)
  //   Structurateur → mise en forme du cours en Markdown pédagogique
  //   Embedding     → vectorisation des fragments pour la recherche
  //
  // ⚠️ EmbeddingDimensions doit correspondre à CoursContext.EmbeddingDimensions :
  // la dimension est figée dans le schéma PostgreSQL (colonne vector(N)). La changer
  // impose une nouvelle migration EF et une réindexation de tous les cours.
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api/v1",
    "Title": "GPOE26",
    "DefaultModel": "openai/gpt-4o-mini",
    "EmbeddingDimensions": 1536,
    "Models": {
      "Vision": "openai/gpt-4o-mini",
      "Structurateur": "openai/gpt-4o-mini",
      "Embedding": "openai/text-embedding-3-small"
    }
  },

  "AllowedHosts": "*"
}
