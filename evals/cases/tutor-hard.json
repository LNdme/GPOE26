  // ─── Calculs en plusieurs étapes et pièges d'unités ─────────────────────────
  {
    "id": "dur-mruv-conversion-kmh",
    "agent": "tutor", "course": "mruv", "tags": ["difficile", "calcul", "unites"],
    "message": "Une voiture roule à 72 km/h et s'arrête en 4 s en freinant régulièrement. Quelle est son accélération ?",
    "checks": [ { "kind": "contains", "values": ["20 m/s", "20\\ \\text{m/s}", "20\\,\\text{m/s}", "20 \\text{m/s}", "20\\ \\mathrm{m/s}"] }, { "kind": "regex", "pattern": "[-−–]\\s*5\\b" } ],
    "rubric": "Convertit 72 km/h = 20 m/s avant tout calcul, puis a = −5 m/s² ; explique le signe."
  },
  {
    "id": "dur-mruv-lancer-vertical",
    "agent": "tutor", "course": "mruv", "tags": ["difficile", "calcul"],
    "message": "On lance une balle verticalement vers le haut à 20 m/s. Quelle hauteur maximale atteint-elle ? On prend g comme dans le cours.",
    "checks": [ { "kind": "regex", "pattern": "\\b20\\s*(\\\\,|\\\\ |~|\\s)*(\\\\text\\{\\s*|\\\\mathrm\\{\\s*)?m\\b(?!\\s*/)" } ],
    "rubric": "Utilise v² − v0² = 2a(x − x0) avec a = −g = −10 m/s² et v = 0 au sommet : h = 20 m."
  },
  {
    "id": "dur-mruv-deux-phases",
    "agent": "tutor", "course": "mruv", "tags": ["difficile", "calcul"],
    "message": "Un bus part du repos, accélère à 1 m/s² pendant 10 s, puis roule à vitesse constante pendant 20 s. Quelle distance totale a-t-il parcourue ?",
    "checks": [ { "kind": "regex", "pattern": "\\b250\\s*(\\\\,|\\\\ |~|\\s)*(\\\\text\\{\\s*|\\\\mathrm\\{\\s*)?m\\b(?!\\s*/)" } ],
    "rubric": "Phase 1 : 50 m et v = 10 m/s ; phase 2 : 200 m ; total 250 m, phases bien séparées."
  },
  {
    "id": "dur-mruv-chute-temps-racine",
    "agent": "tutor", "course": "mruv", "tags": ["difficile", "calcul"],
    "turns": ["Un objet tombe de 80 m sans vitesse initiale. J'ai essayé avec h = ½ g t² et je trouve t² = 16."],
    "message": "Donc t vaut combien, et avec quelle vitesse il touche le sol ?",
    "checks": [ { "kind": "regex", "pattern": "t\\s*=\\s*4|4\\s*(\\\\,|\\\\ |\\s)*(\\\\text\\{\\s*)?s\\b" }, { "kind": "regex", "pattern": "\\b40\\s*(\\\\,|\\\\ |~|\\s)*(\\\\text\\{\\s*|\\\\mathrm\\{\\s*)?m\\s*/\\s*s" } ],
    "rubric": "L'élève a travaillé : confirme t² = 16, t = 4 s, puis v = g·t = 40 m/s."
  },

