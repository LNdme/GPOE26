  {
    "id": "redaction-plan-mruv",
    "agent": "compose", "tags": ["plan"],
    "compose": { "mode": "plan", "subject": "Physique", "title": "Le mouvement rectiligne uniformément varié" },
    "checks": [ { "kind": "regex", "pattern": "^\\s*(#{1,4}\\s|\\d+[.)]\\s|[IVX]+[.)]\\s|\\*\\*[IVX\\d]+)", "min": 3 }, { "kind": "language", "value": "fr" }, { "kind": "contains", "values": ["accélération", "acceleration"] } ],
    "rubric": "Plan détaillé et progressif (définition, équations horaires, applications), structuré en parties numérotées ou titrées."
  },
  {
    "id": "redaction-plan-trois-parties",
    "agent": "compose", "tags": ["plan", "consignes"],
    "compose": { "mode": "plan", "subject": "SVT", "title": "La photosynthèse", "instructions": "Pour des élèves de seconde, en exactement trois grandes parties." },
    "checks": [ { "kind": "contains", "values": ["chlorophylle", "chloroplaste"] }, { "kind": "language", "value": "fr" } ],
    "rubric": "Respecte la consigne : exactement trois grandes parties, niveau seconde."
  },
  {
