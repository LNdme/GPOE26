    "checks": [ { "kind": "regex", "pattern": "9[,.]8" }, { "kind": "contains", "values": ["44"] } ],
    "rubric": "Réécrit sans changer le fond : g ≈ 9,8 m/s², h = ½ g t², 44 m au bout de 3 s ; aucun fait ajouté ni retiré."
  },
  {
