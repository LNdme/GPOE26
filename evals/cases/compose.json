    "checks": [ { "kind": "not_regex", "pattern": "\\$[^$\\n]+\\$" }, { "kind": "contains", "values": ["vapeur", "charbon", "usine", "ouvrier"] } ],
    "rubric": "Plan d'histoire cohérent (causes, transformations, conséquences sociales), sans formule mathématique."
