<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GPOE26.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Typographie de l'application : la police des terminaux (Cascadia Mono, livrée avec Windows 11),
                en petit et dense. Seul le cours, au milieu, a sa propre police, plus grande (Assets/reader/reader.css).
                Les tailles ci-dessous sont celles du réglage « Normale » ; Typography.Apply les augmente d'un ou deux points.
            -->
            <FontFamily x:Key="AppFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
            <FontFamily x:Key="ContentControlThemeFontFamily">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="ContentControlFontSize">12</x:Double>
            <x:Double x:Key="BodyTextBlockFontSize">12</x:Double>
            <x:Double x:Key="CaptionTextBlockFontSize">11</x:Double>
            <x:Double x:Key="SubtitleTextBlockFontSize">16</x:Double>
            <x:Double x:Key="TitleTextBlockFontSize">20</x:Double>
            <x:Double x:Key="ToolTipContentThemeFontSize">11</x:Double>
            <x:Double x:Key="TextControlThemeMinHeight">28</x:Double>
            <x:Double x:Key="ListViewItemMinHeight">30</x:Double>
            <x:Double x:Key="MenuFlyoutThemeMinHeight">28</x:Double>
            <Thickness x:Key="MenuFlyoutItemThemePadding">10,5,10,6</Thickness>
            <Thickness x:Key="ButtonPadding">10,4,10,5</Thickness>
            <Thickness x:Key="TextControlThemePadding">8,4,6,5</Thickness>

            <!-- Styles de texte de WinUI repris ici : les originaux imposent Segoe UI, on garde la police de l'application -->
            <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="{ThemeResource BodyTextBlockFontSize}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="{ThemeResource CaptionTextBlockFontSize}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
            </Style>

            <!-- Menus déroulants et info-bulles : ils s'ouvrent hors de la fenêtre et n'héritent pas de sa police -->
            <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style TargetType="RadioMenuFlyoutItem" BasedOn="{StaticResource DefaultRadioMenuFlyoutItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style TargetType="MenuFlyoutSubItem" BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            </Style>

            <!-- Gabarit commun des en-têtes de panneau (menu, lecture, tuteur) -->
            <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="Margin" Value="10,14,10,4" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
            <!-- Bouton discret du menu (« Nouvelle question ») : comme une ligne de liste, pas un gros bouton plein -->
            <Style x:Key="MenuRowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="10,6" />
            </Style>

            <!-- Barre de droite : titre de section repliable (« OUTILS ⌄ »), lignes d'outil, indications discrètes -->
            <Style x:Key="SectionToggle" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="10,8,10,4" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="FontSize" Value="{ThemeResource CaptionTextBlockFontSize}" />
                <Setter Property="CharacterSpacing" Value="60" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
            <Style x:Key="ToolRow" TargetType="Button" BasedOn="{StaticResource MenuRowButton}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,6" />
            </Style>
            <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <!-- Envoi : un rond plein, comme les messageries d'agents -->
            <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <!-- Touche dans une info-bulle (« Modèle  Ctrl  Maj  M ») -->
            <Style x:Key="KeyChip" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="5,0,5,1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
