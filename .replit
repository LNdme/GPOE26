modules = ["web", "nodejs-20", "dotnet-10.0"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5163
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 5188
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 5212
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5455
externalPort = 3002
exposeLocalhost = true
