@inject GPOE26.Web.Services.ApiClient Api
@using GPOE26.Web.Services
@inject NavigationManager Nav
@rendermode InteractiveServer

<footer class="lt-footer text-white">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-brand">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="lt-logo-square">LT</div>
                    <div class="fw-bold fs-5">LT Nanga-Eboko</div>
                </div>
                <p>
                    La plateforme d’apprentissage du Lycée Technique de Nanga-Eboko.
                    Apprendre, Construire, Réussir.
                </p>
                @if (contact != null && !string.IsNullOrEmpty(contact.Email))
                {
                    <div class="footer-contact">
                        <i class="bi bi-envelope"></i>
                        <a href="mailto:@contact.Email">@contact.Email</a>
                    </div>
                }
            </div>

            <nav class="footer-links" aria-label="La plateforme">
                <h2>La plateforme</h2>
                <ul>
                    <li><a href="/plateforme" class="footer-link">Découvrir la plateforme</a></li>
                    <li><a href="/app/cours" class="footer-link">Cours en ligne</a></li>
                    <li><a href="/app/tuteur" class="footer-link">Tuteur IA</a></li>
                    <li><a href="/tarifs" class="footer-link">Tarifs</a></li>
                </ul>
            </nav>

            <nav class="footer-links" aria-label="Vie scolaire">
                <h2>Vie scolaire</h2>
                <ul>
                    <li><a href="/blog" class="footer-link">Actualités</a></li>
                    <li><a href="/events" class="footer-link">Événements</a></li>
                    <li><a href="/activities" class="footer-link">Clubs et activités</a></li>
                </ul>
            </nav>

            <nav class="footer-links" aria-label="L’établissement">
                <h2>L’établissement</h2>
                <ul>
                    <li><a href="/hierarchy" class="footer-link">Notre équipe</a></li>
                    <li><a href="/#contact" class="footer-link">Nous trouver</a></li>
                    @if (!string.IsNullOrWhiteSpace(contact?.Email))
                    {
                        <li><a href="mailto:@contact.Email" class="footer-link">Nous écrire</a></li>
                    }
                    <li><a href="/login" class="footer-link">Se connecter</a></li>
                </ul>
            </nav>
        </div>

        <div class="footer-bottom">
            <div>
                © @DateTime.UtcNow.Year Lycée Technique de Nanga-Eboko. Tous droits réservés.
            </div>
            @if (!string.IsNullOrWhiteSpace(contact?.Phone))
            {
                <a class="footer-link" href="tel:@contact.Phone">@contact.Phone</a>
            }
        </div>
    </div>
</footer>

@code {
    private Contact? contact;

    protected override async Task OnInitializedAsync()
    {
        try { contact = await Api.GetPrimaryContactAsync(); }
        catch { }
    }
}