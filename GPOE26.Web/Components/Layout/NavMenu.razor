@inject GPOE26.Web.Services.AuthService Auth
@inject NavigationManager Nav
@implements IDisposable
@rendermode InteractiveServer

<nav class="navbar navbar-expand-lg navbar-light lt-header sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="/" aria-label="Lycée Technique de Nanga-Eboko, accueil">
            <div class="lt-logo-circle">LT</div>
            <div class="d-flex flex-column lh-1">
                <span class="fw-bold fs-5 text-brand-dark">LT Nanga-Eboko</span>
                <span class="text-muted-chic lt-brand-caption">Excellence & Innovation</span>
            </div>
        </a>

        <button class="navbar-toggler shadow-none" type="button" @onclick="ToggleNavMenu"
                aria-label="@(collapseNavMenu ? "Ouvrir le menu" : "Fermer le menu")"
                aria-expanded="@(!collapseNavMenu)" aria-controls="main-navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div id="main-navigation" class="collapse navbar-collapse @(collapseNavMenu ? "" : "show")">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="/" Match="NavLinkMatch.All">Accueil</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="/blog">Actualités</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="/events">Événements</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="/activities">Activités</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link px-3" href="/hierarchy">L'Établissement</NavLink>
                </li>

                @if (Auth.IsAuthenticated)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="/cours">Mes Cours</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link px-3" href="/learning">Apprentissage</NavLink>
                    </li>
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-center lt-account-nav">
                @if (Auth.IsAuthenticated)
                {
                    <li class="nav-item dropdown dropdown-menu-end">
                        <a href="#" class="nav-link d-flex align-items-center gap-2" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="bg-brand-dark text-white fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                @(Auth.Profile?.Username?.Substring(0, 1).ToUpper() ?? "U")
                            </div>
                            <span class="d-none d-lg-block text-brand-dark fw-bold">@Auth.Profile?.Username</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="userMenu">
                            <li><a class="dropdown-item py-2" href="/cours"><i class="bi bi-book me-2 text-brand-dark"></i> Mes cours</a></li>
                            <li><a class="dropdown-item py-2" href="/profil"><i class="bi bi-person me-2 text-brand-dark"></i> Profil</a></li>
                            <li><hr class="dropdown-divider my-1" /></li>
                            <li><button class="dropdown-item py-2 text-danger" @onclick="Logout"><i class="bi bi-box-arrow-right me-2"></i> Se déconnecter</button></li>
                        </ul>
                    </li>
                    <li class="nav-item d-lg-none mt-2">
                        <button class="btn btn-outline-light btn-sm w-100" @onclick="Logout">Déconnexion</button>
                    </li>
                }
                else
                {
                    <li class="nav-item me-lg-2 mb-2 mb-lg-0">
                        <a class="btn btn-login" href="/login">Connexion</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-register" href="/register">S’inscrire</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;

    protected override void OnInitialized()
    {
        // On s'abonne à l'événement pour rafraîchir l'UI lors de la connexion/déconnexion
        Auth.OnAuthChanged += StateHasChanged;
    }

    public void Dispose()
    {
        // On se désabonne proprement pour éviter les fuites de mémoire
        Auth.OnAuthChanged -= StateHasChanged;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void Logout()
    {
        Auth.Logout();
        // Redirection vers l'accueil public avec un rechargement forcé pour nettoyer l'état de la page
        Nav.NavigateTo("/", forceLoad: true); 
    }
}