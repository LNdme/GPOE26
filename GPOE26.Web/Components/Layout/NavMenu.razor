@using GPOE26.UI.Components
@using GPOE26.UI.Models
@inject GPOE26.UI.Services.SessionState Session
@inject NavigationManager Nav
@implements IDisposable

<header class="site-nav @(_menuOpen ? "is-open" : "")">
    <div class="container site-nav__bar">
        <a class="site-brand" href="/" aria-label="Lycée Technique de Nanga-Eboko, accueil">
            <span class="site-brand__mark">LT</span>
            <span class="site-brand__text">
                <strong>LT Nanga-Eboko</strong>
                <small>Excellence &amp; Innovation</small>
            </span>
        </a>

        <nav class="site-nav__links" aria-label="Navigation principale">
            @foreach (var link in Links)
            {
                <NavLink class="site-nav__link" href="@link.Href" Match="NavLinkMatch.Prefix">@link.Label</NavLink>
            }
        </nav>

        <div class="site-nav__actions">
            @if (Session.Profile is { } me && Session.IsAuthenticated)
            {
                @if (CanEditSite)
                {
                    <a class="site-nav__admin" href="/admin" title="@AdminLabel" aria-label="@AdminLabel">
                        <Icon Name="shield" Size="18" Stroke="2" />
                        <span>@(me.IsAdmin ? "Admin" : "Gérer le site")</span>
                    </a>
                }
                <a class="site-btn site-btn--primary site-nav__cta" href="/app">Mon espace</a>

                <div class="site-user">
                    <button type="button" class="site-user__toggle" aria-haspopup="menu" aria-expanded="@(_userMenuOpen ? "true" : "false")"
                            aria-label="Menu du compte" @onclick="() => _userMenuOpen = !_userMenuOpen">
                        <span class="site-user__avatar">@Initial(me.Username)</span>
                        <span class="site-user__name">@me.Username</span>
                        <Icon Name="chevron-down" Size="16" Stroke="2" />
                    </button>
                    @if (_userMenuOpen)
                    {
                        <button type="button" class="site-user__backdrop" tabindex="-1" aria-label="Fermer le menu du compte" @onclick="() => _userMenuOpen = false"></button>
                        <div class="site-user__menu" role="menu">
                            <div class="site-user__head">
                                <strong>@me.Username</strong>
                                <small>@GPOE26.UI.Services.Labels.Of(me.Role)@(me.IsAdmin ? " · administrateur" : me.SiteEditor ? " · éditeur du site" : "")</small>
                            </div>
                            <a role="menuitem" href="/app"><Icon Name="grid" Size="18" /> @(me.Role == UserRole.Parent ? "Suivi de mes enfants" : "Mon espace")</a>
                            <a role="menuitem" href="/app/profil"><Icon Name="user" Size="18" /> Mon profil</a>
                            @if (me.Role != UserRole.Parent)
                            {
                                <a role="menuitem" href="/app/cours"><Icon Name="book" Size="18" /> @(me.Role == UserRole.Teacher ? "Mes cours" : "Cours de mes classes")</a>
                            }
                            <a role="menuitem" href="/app/abonnement"><Icon Name="card" Size="18" /> Mon abonnement</a>
                            @if (CanEditSite)
                            {
                                <a role="menuitem" href="/admin" class="is-admin"><Icon Name="shield" Size="18" /> @AdminLabel</a>
                            }
                            <hr />
                            <button role="menuitem" type="button" class="is-danger" @onclick="Logout"><Icon Name="logout" Size="18" /> Se déconnecter</button>
                        </div>
                    }
                </div>
            }
            else
            {
                <a class="site-btn site-btn--ghost site-nav__login" href="/login">Connexion</a>
                <a class="site-btn site-btn--primary site-nav__cta" href="/register">Créer un compte</a>
            }

            <button type="button" class="site-nav__toggle" aria-controls="site-drawer"
                    aria-expanded="@(_menuOpen ? "true" : "false")"
                    aria-label="@(_menuOpen ? "Fermer le menu" : "Ouvrir le menu")"
                    @onclick="() => _menuOpen = !_menuOpen">
                <Icon Name="@(_menuOpen ? "x" : "menu")" Size="22" Stroke="2" />
            </button>
        </div>
    </div>

    @* Menu mobile : toujours présent dans le DOM, déplié sous la barre *@
    <div id="site-drawer" class="site-drawer" hidden="@(!_menuOpen)">
        <div class="container">
            <nav class="site-drawer__links" aria-label="Navigation principale (mobile)">
                <NavLink class="site-drawer__link" href="/" Match="NavLinkMatch.All">Accueil</NavLink>
                @foreach (var link in Links)
                {
                    <NavLink class="site-drawer__link" href="@link.Href" Match="NavLinkMatch.Prefix">@link.Label</NavLink>
                }
            </nav>
            <div class="site-drawer__account">
                @if (Session.IsAuthenticated)
                {
                    <a class="site-btn site-btn--primary" href="/app">Mon espace</a>
                    @if (CanEditSite)
                    {
                        <a class="site-btn site-btn--ghost" href="/admin"><Icon Name="shield" Size="18" /> @AdminLabel</a>
                    }
                    <button type="button" class="site-btn site-btn--quiet" @onclick="Logout">Se déconnecter</button>
                }
                else
                {
                    <a class="site-btn site-btn--primary" href="/register">Créer un compte</a>
                    <a class="site-btn site-btn--ghost" href="/login">Connexion</a>
                }
            </div>
        </div>
    </div>
</header>

@code {
    private bool _menuOpen;
    private bool _userMenuOpen;

    private record NavItem(string Href, string Label);

    private static readonly NavItem[] Links =
    [
        new("/plateforme", "La plateforme"),
        new("/blog", "Actualités"),
        new("/events", "Événements"),
        new("/activities", "Activités"),
        new("/hierarchy", "L’établissement"),
        new("/tarifs", "Tarifs"),
    ];

    // Administrateur ou éditeur du site : accès à l'espace de gestion du contenu
    private bool CanEditSite => Session.IsAuthenticated && Session.Profile?.CanEditSite == true;

    // L'éditeur gère le contenu ; seul l'administrateur gère aussi la plateforme et les accès
    private string AdminLabel => Session.Profile?.IsAdmin == true ? "Administration" : "Gérer le site";

    protected override void OnInitialized()
    {
        Session.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        Session.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    // Une navigation referme les menus ouverts
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _userMenuOpen = false;
        Refresh();
    }

    private static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private async Task Logout()
    {
        // Attendre l'effacement de la session dans le navigateur, sinon le rechargement la restaurerait
        await Session.SignOutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
