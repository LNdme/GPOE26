@page "/admin/actualites"
@layout GPOE26.Web.Components.Layout.AdminLayout
@using GPOE26.UI.Components
@using GPOE26.Web.Components.UI

<PageTitle>Actualités · Administration – GPOE26</PageTitle>

<div class="admin-head">
    <div>
        <span class="admin-eyebrow">Contenu</span>
        <h1>Actualités</h1>
        <p>Les articles publiés apparaissent sur l’accueil et la page Actualités. Les brouillons restent invisibles du public.</p>
    </div>
    <a class="site-btn site-btn--primary" href="/admin/actualites/nouveau"><Icon Name="plus" Size="18" Stroke="2" /> Nouvel article</a>
</div>

@if (_error is not null) { <div class="alert alert-danger" role="alert">@_error</div> }

<div class="admin-card admin-card--flush">
    <div class="admin-toolbar">
        <div class="admin-tabs" role="group" aria-label="Filtrer par statut">
            <button type="button" class="@(_status == null ? "on" : "")" @onclick="() => SetStatus(null)">Tous</button>
            <button type="button" class="@(_status == true ? "on" : "")" @onclick="() => SetStatus(true)">Publiés</button>
            <button type="button" class="@(_status == false ? "on" : "")" @onclick="() => SetStatus(false)">Brouillons</button>
        </div>
        <span class="admin-muted">@_total article@(_total > 1 ? "s" : "")</span>
    </div>

    @if (_loading)
    {
        <div class="admin-empty"><span class="spinner-border spinner-border-sm text-brand-dark" role="status"></span> Chargement…</div>
    }
    else if (_items.Count == 0)
    {
        <div class="admin-empty">
            <Icon Name="news" Size="28" />
            <p>Aucun article dans cette vue.</p>
            <a class="site-btn site-btn--ghost site-btn--sm" href="/admin/actualites/nouveau">Rédiger le premier</a>
        </div>
    }
    else
    {
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr><th scope="col">Article</th><th scope="col">Catégorie</th><th scope="col">Statut</th><th scope="col">Modifié</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in _items)
                    {
                        <tr>
                            <td data-label="Article">
                                <div class="admin-cell-main">
                                    @if (!string.IsNullOrWhiteSpace(a.ImageUrl)) { <img src="@a.ImageUrl" alt="" loading="lazy" /> }
                                    <span><a href="@($"/admin/actualites/{a.Id}")"><strong>@a.Title</strong></a><small>@(a.Excerpt ?? Truncate(a.Content, 90))</small></span>
                                </div>
                            </td>
                            <td data-label="Catégorie"><span class="admin-chip">@a.Category</span></td>
                            <td data-label="Statut"><span class="admin-badge @(a.IsPublished ? "is-ok" : "is-draft")">@(a.IsPublished ? "Publié" : "Brouillon")</span></td>
                            <td data-label="Modifié">@a.UpdatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="admin-actions">
                                <button type="button" class="site-btn site-btn--ghost site-btn--sm" disabled="@(_busyId == a.Id)" @onclick="() => TogglePublish(a)">
                                    @(a.IsPublished ? "Dépublier" : "Publier")
                                </button>
                                @if (a.IsPublished)
                                {
                                    <a class="admin-icon-btn" href="@($"/blog/details/{a.Id}")" target="_blank" rel="noopener" title="Voir sur le site" aria-label="@($"Voir {a.Title} sur le site")"><Icon Name="eye" Size="18" /></a>
                                }
                                <a class="admin-icon-btn" href="@($"/admin/actualites/{a.Id}")" title="Modifier" aria-label="@($"Modifier {a.Title}")"><Icon Name="edit" Size="18" /></a>
                                <button type="button" class="admin-icon-btn is-danger" title="Supprimer" aria-label="@($"Supprimer {a.Title}")" @onclick="() => _toDelete = a"><Icon Name="trash" Size="18" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_totalPages > 1)
        {
            <div class="admin-pager">
                <button type="button" class="site-btn site-btn--quiet site-btn--sm" disabled="@(_page <= 1)" @onclick="() => GoTo(_page - 1)">Précédent</button>
                <span>Page @_page / @_totalPages</span>
                <button type="button" class="site-btn site-btn--quiet site-btn--sm" disabled="@(_page >= _totalPages)" @onclick="() => GoTo(_page + 1)">Suivant</button>
            </div>
        }
    }
</div>

<ConfirmDialog Open="_toDelete is not null" Busy="_deleting" OnCancel="() => _toDelete = null" OnConfirm="Delete">
    <p>L’article <strong>@_toDelete?.Title</strong> sera définitivement supprimé du site.</p>
</ConfirmDialog>

@code {
    private const int PageSize = 15;
    private bool _loading = true, _deleting;
    private bool? _status;
    private int _page = 1, _total;
    private int _totalPages => (int)Math.Ceiling((double)_total / PageSize);
    private List<NewArticle> _items = new();
    private NewArticle? _toDelete;
    private Guid? _busyId;
    private string? _error;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        (_total, _items) = await Api.GetNewsAsync(published: _status, page: _page, pageSize: PageSize);
        _loading = false;
    }

    private async Task SetStatus(bool? status) { _status = status; _page = 1; await Load(); }
    private async Task GoTo(int page) { _page = page; await Load(); }

    private async Task TogglePublish(NewArticle a)
    {
        _busyId = a.Id; _error = null;
        var updated = a with { IsPublished = !a.IsPublished, PublishedAt = !a.IsPublished ? DateTime.UtcNow : a.PublishedAt };
        if (!await Api.UpdateNewsAsync(a.Id, updated))
            _error = "La modification a échoué. Votre session administrateur a peut-être expiré : reconnectez-vous.";
        _busyId = null;
        await Load();
    }

    private async Task Delete()
    {
        if (_toDelete is null) return;
        _deleting = true; _error = null;
        if (!await Api.DeleteNewsAsync(_toDelete.Id))
            _error = "La suppression a échoué. Votre session administrateur a peut-être expiré : reconnectez-vous.";
        _toDelete = null; _deleting = false;
        await Load();
    }

    private static string Truncate(string? text, int max) =>
        string.IsNullOrEmpty(text) ? "" : text.Length <= max ? text : text[..max] + "…";
}
