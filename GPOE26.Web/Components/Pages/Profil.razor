@page "/profil"
@* Api et Nav viennent de _Imports.razor. *@
@inject GPOE26.Web.Services.AuthService Auth
@rendermode InteractiveServer

<PageTitle>Mon profil – GPOE26</PageTitle>

@*
    Le profil, et surtout le lien famille vu du côté de l'élève.

    C'est l'élève qui émet le code, jamais le parent : le rattachement ne peut donc pas
    exister sans qu'il l'ait voulu. Et il voit qui le suit, avec le moyen de le défaire —
    sans quoi le « suivi parental actif » affiché dans la page d'étude ne serait qu'une
    formule.
*@

<div class="profil">

    @if (!Auth.IsAuthenticated)
    {
        <div class="profil-empty">
            <h5>Vous n'êtes pas connecté</h5>
            <a class="btn btn-brand mt-2" href="/login">Se connecter</a>
        </div>
    }
    else
    {
        var profile = Auth.Profile;

        <header class="profil-head">
            <div class="profil-avatar">@Initial(profile?.Username)</div>
            <div>
                <h1 class="profil-name">@profile?.Username</h1>
                <p class="profil-meta">
                    @RoleLabel(profile?.Role)
                    @if (!string.IsNullOrWhiteSpace(profile?.Level))
                    {
                        <span> · @profile!.Level</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile?.Filiere))
                    {
                        <span> · @profile!.Filiere</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile?.Specialite))
                    {
                        <span> · @profile!.Specialite</span>
                    }
                </p>
                <p class="profil-meta">@profile?.Email</p>
            </div>
        </header>

        @if (Auth.IsParent)
        {
            <section class="profil-card">
                <h2 class="profil-card-title">Espace famille</h2>
                <p class="profil-card-hint">
                    Le suivi de vos enfants se trouve dans l'espace famille.
                </p>
                <a class="btn btn-brand btn-sm" href="/famille">Ouvrir l'espace famille</a>
            </section>
        }
        else if (Auth.IsTeacher)
        {
            @* Un enseignant n'a ni parent à rattacher ni classe à rejoindre : il en tient. *@
            <section class="profil-card">
                <h2 class="profil-card-title">Mes classes</h2>
                <p class="profil-card-hint">
                    Le suivi de vos élèves se trouve dans vos classes.
                </p>
                <a class="btn btn-brand btn-sm" href="/classe">Ouvrir mes classes</a>
            </section>
        }
        else
        {
            @* ── Rejoindre une classe ────────────────────────────────────────── *@
            <section class="profil-card">
                <h2 class="profil-card-title">Rejoindre une classe</h2>
                <p class="profil-card-hint">
                    Saisissez le code que votre professeur vous a donné. Il verra votre
                    progression — temps de travail, étapes validées, notions difficiles —
                    mais <strong>jamais vos échanges avec le répétiteur</strong>.
                </p>

                <div class="profil-join">
                    <input class="profil-join-input"
                           maxlength="6"
                           placeholder="Code à 6 caractères"
                           @bind="_classCode"
                           @bind:event="oninput"
                           disabled="@_joining" />

                    <button class="btn btn-brand btn-sm"
                            disabled="@(_joining || string.IsNullOrWhiteSpace(_classCode))"
                            @onclick="JoinClassAsync">
                        @if (_joining)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Rejoindre
                    </button>
                </div>

                @if (_classError is not null)
                {
                    <p class="profil-error">@_classError</p>
                }

                @if (_loadingClasses)
                {
                    <p class="profil-card-hint mt-3">Chargement…</p>
                }
                else if (_classes.Count > 0)
                {
                    <ul class="profil-list mt-3">
                        @foreach (var c in _classes)
                        {
                            <li>
                                <div>
                                    <span class="profil-list-name">@c.Name</span>
                                    <span class="profil-list-meta">
                                        @c.Subject · @c.TeacherName · depuis le
                                        @c.JoinedAt.ToLocalTime().ToString("d MMMM yyyy")
                                    </span>
                                </div>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => LeaveClassAsync(c)"
                                        disabled="@(_leaving == c.Id)">
                                    Quitter
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="profil-card">
                <h2 class="profil-card-title">Laisser un parent suivre ma progression</h2>
                <p class="profil-card-hint">
                    Générez un code et communiquez-le à votre parent. Il verra votre progression
                    — temps de travail, étapes validées, notions difficiles — mais
                    <strong>jamais vos échanges avec le répétiteur</strong>.
                </p>

                @if (_code is not null)
                {
                    <div class="profil-code">
                        <span class="profil-code-value">@_code.Code</span>
                        <span class="profil-code-hint">
                            @if (_code.MinutesLeft > 0)
                            {
                                <text>Valable @_code.MinutesLeft minutes, une seule fois.</text>
                            }
                            else
                            {
                                <text>Ce code a expiré — générez-en un nouveau.</text>
                            }
                        </span>
                    </div>
                }

                <button class="btn btn-brand btn-sm" @onclick="GenerateCodeAsync" disabled="@_generating">
                    @if (_generating)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    @(_code is null ? "Générer un code" : "Générer un nouveau code")
                </button>

                @if (_error is not null)
                {
                    <p class="profil-error">@_error</p>
                }
            </section>

            <section class="profil-card">
                <h2 class="profil-card-title">Qui suit ma progression</h2>

                @if (_loadingParents)
                {
                    <p class="profil-card-hint">Chargement…</p>
                }
                else if (_parents.Count == 0)
                {
                    <p class="profil-card-hint">Personne pour l'instant.</p>
                }
                else
                {
                    <ul class="profil-list">
                        @foreach (var parent in _parents)
                        {
                            <li>
                                <div>
                                    <span class="profil-list-name">@parent.Username</span>
                                    <span class="profil-list-meta">
                                        @parent.Email · depuis le @parent.LinkedAt.ToLocalTime().ToString("d MMMM yyyy")
                                    </span>
                                </div>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => UnlinkParentAsync(parent)"
                                        disabled="@(_unlinking == parent.Id)">
                                    Retirer
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }
</div>

@code {
    private LinkCodeResponse? _code;
    private List<LinkedParentDto> _parents = [];
    private List<MyClassDto> _classes = [];

    private bool _generating;
    private bool _loadingParents = true;
    private bool _loadingClasses = true;
    private Guid? _unlinking;
    private string? _error;

    private string _classCode = "";
    private bool _joining;
    private Guid? _leaving;
    private string? _classError;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || Auth.IsParent || Auth.IsTeacher)
        {
            _loadingParents = false;
            _loadingClasses = false;
            return;
        }

        // Les deux listes en parallèle : elles vont au même service et ne dépendent pas
        // l'une de l'autre.
        var parents = Api.GetMyParentsAsync();
        var classes = Api.GetMyEnrolledClassesAsync();

        _parents = await parents;
        _loadingParents = false;

        _classes = await classes;
        _loadingClasses = false;
    }

    private async Task JoinClassAsync()
    {
        if (string.IsNullOrWhiteSpace(_classCode) || _joining) return;

        _joining = true;
        _classError = null;

        var (joined, error) = await Api.JoinClassAsync(_classCode.Trim().ToUpperInvariant());

        if (joined is null)
        {
            _classError = error;
            _joining = false;
            return;
        }

        // Aucun jeton à rafraîchir, contrairement au rattachement d'un parent : le droit
        // de l'enseignant ne vit pas dans un claim, il se lit dans l'effectif de ses
        // classes au moment où il consulte.
        _classCode = "";
        _classes = [joined, .. _classes.Where(c => c.Id != joined.Id)];
        _joining = false;
    }

    private async Task LeaveClassAsync(MyClassDto schoolClass)
    {
        _leaving = schoolClass.Id;

        if (await Api.LeaveClassAsync(schoolClass.Id))
            _classes = _classes.Where(c => c.Id != schoolClass.Id).ToList();
        else
            _classError = "Vous n'avez pas pu quitter cette classe.";

        _leaving = null;
    }

    private async Task GenerateCodeAsync()
    {
        _generating = true;
        _error = null;

        _code = await Api.GenerateLinkCodeAsync();
        if (_code is null) _error = "Le code n'a pas pu être généré. Réessayez.";

        _generating = false;
    }

    private async Task UnlinkParentAsync(LinkedParentDto parent)
    {
        _unlinking = parent.Id;

        if (await Api.UnlinkParentAsync(parent.Id))
            _parents = _parents.Where(p => p.Id != parent.Id).ToList();
        else
            _error = "Le lien n'a pas pu être retiré.";

        _unlinking = null;
    }

    private static string Initial(string? username) =>
        string.IsNullOrWhiteSpace(username) ? "?" : username[..1].ToUpperInvariant();

    private static string RoleLabel(string? role) => role switch
    {
        "Student" => "Élève",
        "Teacher" => "Enseignant",
        "Parent" => "Parent",
        _ => "Compte",
    };
}
