@page "/blog"
@rendermode InteractiveServer

<PageTitle>Actualités – GPOE26</PageTitle>

<div class="listing-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">La vie de l’établissement</span>
                <h1 class="listing-title">Actualités</h1>
                <p class="listing-description">Les nouvelles, les projets et les temps forts du lycée.</p>
            </div>
            <a href="/blog/create" class="listing-create-button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nouvel article
            </a>
        </header>

        <div class="listing-filters" aria-label="Filtrer les actualités">
            <button class="btn @(_selectedCategory == null ? "btn-navy" : "btn-outline-secondary")" @onclick='() => FilterByCategory(null)'>Toutes</button>
            @foreach (var cat in _categories)
            {
                <button class="btn @(_selectedCategory == cat ? "btn-navy" : "btn-outline-secondary")" @onclick='() => FilterByCategory(cat)'>@cat</button>
            }
        </div>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement des actualités…</p>
            </div>
        }
        else if (!_articles.Any())
        {
            <div class="listing-state">
                <i class="bi bi-journal-text" aria-hidden="true"></i>
                <h2>Aucun article pour le moment</h2>
                <p>Les prochaines actualités de l’établissement apparaîtront ici.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var article in _articles)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="content-card">
                            <div class="content-card__image @(string.IsNullOrWhiteSpace(article.ImageUrl) ? "content-card__image--illustration" : string.Empty)">
                                <img src="@(string.IsNullOrWhiteSpace(article.ImageUrl) ? "/images/learning-together.webp" : article.ImageUrl)"
                                     alt="@article.Title" loading="lazy" />
                            </div>
                            <div class="content-card__body">
                                <div class="content-card__meta">
                                    <span class="content-tag">@article.Category</span>
                                    <time>@article.CreatedAt.ToString("dd MMM yyyy")</time>
                                </div>
                                <h2>@article.Title</h2>
                                <p class="content-card__description">@(article.Excerpt ?? Truncate(article.Content, 120))</p>
                                <div class="content-card__actions">
                                    <a href="@($"/blog/details/{article.Id}")" class="content-card__primary-link">
                                        Lire l’article <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                    <a href="@($"/blog/edit/{article.Id}")" class="content-card__icon-action"
                                       title="Modifier l’article" aria-label="@($"Modifier {article.Title}")">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button class="content-card__icon-action content-card__icon-action--danger"
                                            title="Supprimer l’article" aria-label="@($"Supprimer {article.Title}")"
                                            @onclick="() => ConfirmDelete(article)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            @if (_totalPages > 1)
            {
                <nav class="mt-4" aria-label="Pagination des actualités">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(_currentPage <= 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_currentPage - 1)">Précédent</button>
                        </li>
                        @for (int i = 1; i <= _totalPages; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(pageNum == _currentPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(pageNum)" aria-current="@(pageNum == _currentPage ? "page" : null)">@pageNum</button>
                            </li>
                        }
                        <li class="page-item @(_currentPage >= _totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(_currentPage + 1)">Suivant</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@* Modal de confirmation de suppression *@
@if (_articleToDelete is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmer la suppression</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Voulez-vous vraiment supprimer l'article <strong>@_articleToDelete.Title</strong> ?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Annuler</button>
                    <button class="btn btn-danger" @onclick="DeleteArticle" disabled="@_deleting">
                        @if (_deleting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _deleting = false;
    private List<NewArticle> _articles = new();
    private NewArticle? _articleToDelete;
    private int _total;
    private int _currentPage = 1;
    private int _pageSize = 9;
    private int _totalPages => (int)Math.Ceiling((double)_total / _pageSize);
    private string? _selectedCategory;
    private readonly string[] _categories = { "Général", "Sport", "Culturel", "Administratif" };

    protected override async Task OnInitializedAsync()
    {
        await LoadArticles();
    }

    private async Task LoadArticles()
    {
        _loading = true;
        var result = await Api.GetNewsAsync(category: _selectedCategory, page: _currentPage, pageSize: _pageSize);
        _total = result.total;
        _articles = result.items;
        _loading = false;
    }

    private async Task FilterByCategory(string? category)
    {
        _selectedCategory = category;
        _currentPage = 1;
        await LoadArticles();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return;
        _currentPage = page;
        await LoadArticles();
    }

    private void ConfirmDelete(NewArticle article) => _articleToDelete = article;
    private void CancelDelete() => _articleToDelete = null;

    private async Task DeleteArticle()
    {
        if (_articleToDelete is null) return;
        _deleting = true;
        await Api.DeleteNewsAsync(_articleToDelete.Id);
        _articleToDelete = null;
        _deleting = false;
        await LoadArticles();
    }

    private static string Truncate(string text, int maxLength)
        => text.Length <= maxLength ? text : text[..maxLength] + "…";
}
