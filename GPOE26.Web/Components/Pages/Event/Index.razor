@page "/events"
@inject GPOE26.UI.Services.SessionState Session

<PageTitle>Événements – GPOE26</PageTitle>

<div class="listing-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">À vivre ensemble</span>
                <h1 class="listing-title">Événements</h1>
                <p class="listing-description">Retrouvez les rendez-vous et les moments importants du lycée.</p>
            </div>
            @if (IsAdmin)
            {
                <a href="/admin/evenements" class="listing-create-button">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Gérer les événements
                </a>
            }
        </header>

        <div class="listing-filters" aria-label="Filtrer les événements">
            <button class="btn @(_selectedType == null ? "btn-navy" : "btn-outline-secondary")" @onclick='() => FilterByType(null)'>Tous</button>
            @foreach (var t in _types)
            {
                <button class="btn @(_selectedType == t ? "btn-navy" : "btn-outline-secondary")" @onclick='() => FilterByType(t)'>@t</button>
            }
        </div>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement des événements…</p>
            </div>
        }
        else if (!_events.Any())
        {
            <div class="listing-state">
                <i class="bi bi-calendar-event" aria-hidden="true"></i>
                <h2>Aucun événement à afficher</h2>
                <p>Les prochains rendez-vous du lycée seront annoncés ici.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var ev in _events)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="content-card">
                            <div class="content-card__image @(string.IsNullOrWhiteSpace(ev.ImageUrl) ? "content-card__image--illustration" : string.Empty)">
                                <img src="@(string.IsNullOrWhiteSpace(ev.ImageUrl) ? "/images/future-learning.webp" : ev.ImageUrl)"
                                     alt="@ev.Title" loading="lazy" />
                            </div>
                            <div class="content-card__body">
                                <div class="content-card__meta">
                                    <span class="content-tag">@ev.Type</span>
                                    <time>@ev.StartDate.ToString("dd MMM yyyy")</time>
                                </div>
                                <h2>@ev.Title</h2>
                                <p class="content-card__description">@Truncate(ev.Description, 120)</p>
                                <div class="content-card__details">
                                    <span><i class="bi bi-calendar3" aria-hidden="true"></i> @ev.StartDate.ToString("dd MMM yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(ev.Location))
                                    {
                                        <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @ev.Location</span>
                                    }
                                </div>
                                <div class="content-card__actions">
                                    <a href="@($"/events/details/{ev.Id}")" class="content-card__primary-link">
                                        Voir l’événement <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>


@code {
    private bool IsAdmin => Session.IsAuthenticated && Session.Profile?.CanEditSite == true;

    private bool _loading = true;
    private List<SchoolEvent> _events = new();
    private string? _selectedType;
    private readonly string[] _types = { "Général", "JPOE", "Sportif", "Culturel", "Administratif", "Voyage" };

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        _events = await Api.GetAllEventsAsync(_selectedType);
        _loading = false;
    }

    private async Task FilterByType(string? type) { _selectedType = type; await Load(); }

    private static string Truncate(string t, int m) => t.Length <= m ? t : t[..m] + "…";
}
