@page "/events/details/{Id:guid}"
@rendermode InteractiveServer

<PageTitle>Événement – GPOE26</PageTitle>

<div class="container management-page">
    @if (_loading)
    {
        <div class="management-state"><div class="spinner-border"></div></div>
    }
    else if (_ev is null)
    {
        <div class="management-state"><p class="text-muted fs-5">Événement introuvable.</p><a href="/events" class="btn btn-outline-secondary">Retour</a></div>
    }
    else
    {
        <article class="management-detail">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/events" class="text-navy text-decoration-none">Événements</a></li>
                    <li class="breadcrumb-item active">@_ev.Title</li>
                </ol>
            </nav>

            <span class="management-badge mb-3">@_ev.Type</span>
            @if (!_ev.IsPublic) { <span class="management-badge ms-2">Privé</span> }

            @if (!string.IsNullOrEmpty(_ev.ImageUrl))
            {
                <img src="@_ev.ImageUrl" alt="@_ev.Title" class="management-cover" />
            }

            <h1>@_ev.Title</h1>

            <div class="management-detail__meta">
                <span>📅 @_ev.StartDate.ToString("dd MMMM yyyy")</span>
                @if (_ev.EndDate.HasValue) { <span>→ @_ev.EndDate.Value.ToString("dd MMMM yyyy")</span> }
                @if (!string.IsNullOrEmpty(_ev.Location)) { <span>📍 @_ev.Location</span> }
            </div>

            <div class="management-detail__copy">@_ev.Description</div>

            <hr />
            <div class="management-actions">
                <a href="@($"/events/edit/{_ev.Id}")" class="btn btn-navy">Modifier</a>
                <a href="/events" class="btn btn-outline-secondary">Retour</a>
            </div>
        </article>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private SchoolEvent? _ev;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _ev = await Api.GetEventByIdAsync(Id);
        _loading = false;
    }
}
