@page "/hierarchy/edit/{Id:int}"
@rendermode InteractiveServer

<PageTitle>Modifier membre – GPOE26</PageTitle>

<div class="container management-page">
    <div class="form-section management-shell">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/hierarchy" class="text-navy text-decoration-none">Hiérarchie</a></li>
                <li class="breadcrumb-item active">Modifier</li>
            </ol>
        </nav>

        @if (_loading)
        {
            <div class="management-state"><div class="spinner-border"></div></div>
        }
        else if (_item is null)
        {
            <div class="alert alert-warning">Membre introuvable.</div>
            <a href="/hierarchy" class="btn btn-outline-secondary">Retour</a>
        }
        else
        {
            <header class="management-heading">
                <span class="listing-eyebrow">Équipe · Gestion</span>
                <h1 class="listing-title">Modifier le membre</h1>
            </header>
            @if (!string.IsNullOrEmpty(_errorMessage)) { <div class="alert alert-danger">@_errorMessage</div> }

            <EditForm Model="_item" OnValidSubmit="Submit" FormName="EditHierarchyForm" class="management-form">
                <DataAnnotationsValidator />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Nom</label>
                        <InputText @bind-Value="_item.Name" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Prénom</label>
                        <InputText @bind-Value="_item.PreName" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Rôle *</label>
                    <InputSelect @bind-Value="_item.Role" class="form-select">
                        <option value="Administration">Administration</option>
                        <option value="Enseignants">Enseignants</option>
                        <option value="Étudiants">Étudiants</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Description</label>
                    <InputTextArea @bind-Value="_item.Description" class="form-control" rows="3" />
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Département</label>
                        <InputText @bind-Value="_item.Department" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Spécialisation</label>
                        <InputText @bind-Value="_item.Specialization" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <InputText @bind-Value="_item.Email" class="form-control" />
                </div>
                <div class="mb-3">
                <label class="form-label fw-semibold">Image (URL ou Upload)</label>
                <div class="input-group">
                    <InputText @bind-Value="_item.ImageUrl" class="form-control" />
                    <InputFile OnChange="HandleImageUpload" class="form-control" accept="image/*" />
                </div>
                @if (_isUploading)
                {
                    <div class="form-text text-info">Téléchargement en cours...</div>
                }
            </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold">Citation</label>
                    <InputTextArea @bind-Value="_item.Citation" class="form-control" rows="2" />
                </div>
                <div class="management-actions">
                    <button type="submit" class="btn btn-navy" disabled="@_saving">
                        @if (_saving) { <span class="spinner-border spinner-border-sm me-1"></span> } Enregistrer
                    </button>
                    <a href="/hierarchy" class="btn btn-outline-secondary">Annuler</a>
                </div>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Hierarchy? _item;
    private string _roleOther = "";
    private bool _loading = true;
    private bool _saving = false;
    private string? _errorMessage;
    private bool _isUploading = false;

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        _isUploading = true;
        try
        {
            var file = e.File;
            if (file.Size > 5 * 1024 * 1024)
            {
                _errorMessage = "Fichier trop volumineux (max 5MB).";
                return;
            }
            using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var url = await Api.UploadImageAsync(stream, file.Name);
            if (url != null && _item != null)
            {
                _item.ImageUrl = url;
            }
            else _errorMessage = "Erreur upload.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erreur upload : {ex.Message}";
        }
        finally
        {
            _isUploading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync() { _item = await Api.GetHierarchyByIdAsync(Id); _loading = false; }

    private async Task Submit()
    {
        if (_item is null) return;
        if (_item.Role == "Autre" && !string.IsNullOrWhiteSpace(_roleOther)) _item.Role = _roleOther;
        _saving = true; _errorMessage = null;
        var ok = await Api.UpdateHierarchyAsync(Id, _item);
        _saving = false;
        if (ok) Nav.NavigateTo("/hierarchy");
        else _errorMessage = "Erreur lors de la mise à jour.";
    }
}
