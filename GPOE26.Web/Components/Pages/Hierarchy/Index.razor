@page "/hierarchy"
@inject GPOE26.UI.Services.SessionState Session

<PageTitle>Personnel – GPOE26</PageTitle>

<div class="listing-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">Celles et ceux qui font le lycée</span>
                <h1 class="listing-title">Notre équipe</h1>
                <p class="listing-description">Découvrez les personnes qui accompagnent les élèves au quotidien.</p>
            </div>
            @if (IsAdmin)
            {
                <a href="/admin/equipe" class="listing-create-button">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Gérer l’équipe
                </a>
            }
        </header>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement de l’équipe…</p>
            </div>
        }
        else if (!_items.Any())
        {
            <div class="listing-state">
                <i class="bi bi-people" aria-hidden="true"></i>
                <h2>Aucun membre à afficher</h2>
                <p>Les membres de l’équipe apparaîtront ici.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var m in _items)
                {
                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <article class="team-directory-card">
                            <div class="team-directory-card__portrait">
                                @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                                {
                                    <img src="@m.ImageUrl" alt="@($"{m.PreName} {m.Name}")" loading="lazy" />
                                }
                                else
                                {
                                    <span>@(m.Name?.FirstOrDefault())</span>
                                }
                            </div>
                            <h2>@m.PreName @m.Name</h2>
                            <p class="team-directory-card__role">@m.Role</p>
                            @if (!string.IsNullOrWhiteSpace(m.Department))
                            {
                                <p class="team-directory-card__department">@m.Department</p>
                            }
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>


@code {
    private bool IsAdmin => Session.Role == GPOE26.UI.Models.UserRole.Admin;

    private bool _loading = true;
    private List<Hierarchy> _items = new();

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        await Load();
    }
    private async Task Load() { _loading = true; _items = await Api.GetHierarchyAsync(); _loading = false; }
}
