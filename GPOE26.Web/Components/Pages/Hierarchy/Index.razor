@page "/hierarchy"
@rendermode InteractiveServer

<PageTitle>Personnel – GPOE26</PageTitle>

<div class="listing-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">Celles et ceux qui font le lycée</span>
                <h1 class="listing-title">Notre équipe</h1>
                <p class="listing-description">Découvrez les personnes qui accompagnent les élèves au quotidien.</p>
            </div>
            <a href="/hierarchy/create" class="listing-create-button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un membre
            </a>
        </header>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement de l’équipe…</p>
            </div>
        }
        else if (!_items.Any())
        {
            <div class="listing-state">
                <i class="bi bi-people" aria-hidden="true"></i>
                <h2>Aucun membre à afficher</h2>
                <p>Les membres de l’équipe apparaîtront ici.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var m in _items)
                {
                    <div class="col-sm-6 col-lg-4 col-xl-3">
                        <article class="team-directory-card">
                            <div class="team-directory-card__portrait">
                                @if (!string.IsNullOrWhiteSpace(m.ImageUrl))
                                {
                                    <img src="@m.ImageUrl" alt="@($"{m.PreName} {m.Name}")" loading="lazy" />
                                }
                                else
                                {
                                    <span>@(m.Name?.FirstOrDefault())</span>
                                }
                            </div>
                            <h2>@m.PreName @m.Name</h2>
                            <p class="team-directory-card__role">@m.Role</p>
                            @if (!string.IsNullOrWhiteSpace(m.Department))
                            {
                                <p class="team-directory-card__department">@m.Department</p>
                            }
                            <div class="team-directory-card__actions">
                                <a href="@($"/hierarchy/edit/{m.Id}")" class="content-card__icon-action"
                                   title="Modifier le membre" aria-label="@($"Modifier {m.PreName} {m.Name}")">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <button class="content-card__icon-action content-card__icon-action--danger"
                                        title="Supprimer le membre" aria-label="@($"Supprimer {m.PreName} {m.Name}")"
                                        @onclick="() => ConfirmDel(m)">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (_toDel is not null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Confirmer la suppression</h5><button type="button" class="btn-close" @onclick="CancelDel"></button></div>
                <div class="modal-body"><p>Supprimer <strong>@_toDel.PreName @_toDel.Name</strong> ?</p></div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDel">Annuler</button>
                    <button class="btn btn-danger" @onclick="Del" disabled="@_deleting">
                        @if (_deleting) { <span class="spinner-border spinner-border-sm me-1"></span> } Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true, _deleting;
    private List<Hierarchy> _items = new();
    private Hierarchy? _toDel;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { _loading = true; _items = await Api.GetHierarchyAsync(); _loading = false; }
    private void ConfirmDel(Hierarchy m) => _toDel = m;
    private void CancelDel() => _toDel = null;
    private async Task Del()
    {
        if (_toDel is null) return;
        _deleting = true;
        await Api.DeleteHierarchyAsync(_toDel.Id);
        _toDel = null; _deleting = false;
        await Load();
    }
}
