@page "/activities/details/{Id:guid}"
@rendermode InteractiveServer

<PageTitle>Activité – GPOE26</PageTitle>

<div class="container management-page">
    @if (_loading)
    {
        <div class="management-state"><div class="spinner-border"></div></div>
    }
    else if (_item is null)
    {
        <div class="management-state"><p class="text-muted fs-5">Activité introuvable.</p><a href="/activities" class="btn btn-outline-secondary">Retour</a></div>
    }
    else
    {
        <article class="management-detail">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/activities" class="text-navy text-decoration-none">Activités</a></li>
                    <li class="breadcrumb-item active">@_item.Name</li>
                </ol>
            </nav>

            <div class="d-flex gap-2 mb-3">
                <span class="management-badge">@_item.Category</span>
                @if (!_item.IsActive) { <span class="management-badge">Inactive</span> }
            </div>

            @if (!string.IsNullOrEmpty(_item.ImageUrl))
            {
                <img src="@_item.ImageUrl" alt="@_item.Name" class="management-cover" />
            }

            <h1>@_item.Name</h1>

            @if (!string.IsNullOrEmpty(_item.Schedule))
            {
                <p class="text-muted"><strong>🕐 Horaire :</strong> @_item.Schedule</p>
            }
            @if (!string.IsNullOrEmpty(_item.ResponsibleTeacher))
            {
                <p class="text-muted"><strong>👨‍🏫 Responsable :</strong> @_item.ResponsibleTeacher</p>
            }

            <div class="management-detail__copy">@_item.Description</div>

            <hr />
            <div class="management-actions">
                <a href="@($"/activities/edit/{_item.Id}")" class="btn btn-navy">Modifier</a>
                <a href="/activities" class="btn btn-outline-secondary">Retour</a>
            </div>
        </article>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private SchoolActivity? _item;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() { _item = await Api.GetActivityByIdAsync(Id); _loading = false; }
}
