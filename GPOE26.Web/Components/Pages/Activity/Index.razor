@page "/activities"
@inject GPOE26.UI.Services.SessionState Session

<PageTitle>Activités – GPOE26</PageTitle>

<div class="listing-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">Apprendre en faisant</span>
                <h1 class="listing-title">Clubs et activités</h1>
                <p class="listing-description">Explorez vos passions, rencontrez d’autres élèves et lancez-vous dans un nouveau projet.</p>
            </div>
            @if (IsAdmin)
            {
                <a href="/admin/activites" class="listing-create-button">
                    <i class="bi bi-pencil" aria-hidden="true"></i> Gérer les activités
                </a>
            }
        </header>

        <div class="listing-filters" aria-label="Filtrer les activités">
            <button class="btn @(_selCat == null ? "btn-navy" : "btn-outline-secondary")" @onclick='() => Filter(null)'>Toutes</button>
            @foreach (var c in _cats)
            {
                <button class="btn @(_selCat == c ? "btn-navy" : "btn-outline-secondary")" @onclick='() => Filter(c)'>@c</button>
            }
        </div>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement des activités…</p>
            </div>
        }
        else if (!_items.Any())
        {
            <div class="listing-state">
                <i class="bi bi-lightbulb" aria-hidden="true"></i>
                <h2>Aucune activité dans cette catégorie</h2>
                <p>Choisissez un autre filtre ou revenez découvrir les prochaines activités.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var a in _items)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="content-card">
                            <div class="content-card__image @(string.IsNullOrWhiteSpace(a.ImageUrl) ? "content-card__image--illustration" : string.Empty)">
                                <img src="@ActivityImage(a)" alt="@a.Name" loading="lazy" />
                            </div>
                            <div class="content-card__body">
                                <div class="content-card__meta">
                                    <span class="content-tag">@a.Category</span>
                                    @if (!a.IsActive)
                                    {
                                        <span>Inactive</span>
                                    }
                                </div>
                                <h2>@a.Name</h2>
                                <p class="content-card__description">@Truncate(a.Description, 120)</p>
                                @if (!string.IsNullOrWhiteSpace(a.Schedule) || !string.IsNullOrWhiteSpace(a.ResponsibleTeacher))
                                {
                                    <div class="content-card__details">
                                        @if (!string.IsNullOrWhiteSpace(a.Schedule))
                                        {
                                            <span><i class="bi bi-clock" aria-hidden="true"></i> @a.Schedule</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(a.ResponsibleTeacher))
                                        {
                                            <span><i class="bi bi-person" aria-hidden="true"></i> @a.ResponsibleTeacher</span>
                                        }
                                    </div>
                                }
                                <div class="content-card__actions">
                                    <a href="@($"/activities/details/{a.Id}")" class="content-card__primary-link">
                                        Découvrir l’activité <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>


@code {
    private bool IsAdmin => Session.IsAuthenticated && Session.Profile?.CanEditSite == true;

    private bool _loading = true;
    private List<SchoolActivity> _items = new();
    private string? _selCat;
    private readonly string[] _cats = { "Sport", "Art", "Science", "Club" };

    protected override async Task OnInitializedAsync()
    {
        await Session.RestoreAsync();
        await Load();
    }
    private async Task Load() { _loading = true; _items = await Api.GetActiveActivitiesAsync(_selCat); _loading = false; }
    private async Task Filter(string? c) { _selCat = c; await Load(); }

    private static string ActivityImage(SchoolActivity activity)
    {
        if (!string.IsNullOrWhiteSpace(activity.ImageUrl)) return activity.ImageUrl;
        return activity.Category?.ToLowerInvariant() switch
        {
            "science" => "/images/future-learning.webp",
            "sport" => "/images/learning-together.webp",
            _ => "/images/digital-learning.webp"
        };
    }

    private static string Truncate(string t, int m) => t.Length <= m ? t : t[..m] + "…";
}
