@using GPOE26.Web.Components.UI
@using GPOE26.Web.Models
@inject GPOE26.Web.Services.ApiClient Api

@*
    Les deux étapes où l'élève rédige au lieu de reconnaître.

    · L'exercice de consolidation : appliquer une notion du cours.
    · La question de synthèse, en toute fin de parcours : dire ce que le cours
      raconte dans son ensemble. On peut valider tous les QCM d'un cours découpé
      en cinq parties sans avoir jamais saisi ce qu'il dit — c'est cet écart-là
      qu'on vient mesurer.

    Même forme (énoncé, rédaction, correction), donc un seul composant : seuls les
    mots changent, et l'API sollicitée. Le corrigé reste masqué tant que l'élève
    n'a pas soumis : le révéler avant viderait l'étape de son sens.
*@

<div class="@RootClass">

    @if (_loading)
    {
        <div class="exercise-state">
            <div class="spinner-border text-brand-dark mb-3"></div>
            <h5>@(IsSynthesis ? "Préparation de votre question de synthèse…" : "Préparation de votre exercice…")</h5>
            <p class="text-muted-chic">
                @(IsSynthesis
                    ? "Elle portera sur l'ensemble du cours, pas sur un détail."
                    : "Il portera sur ce que vous venez d'étudier.")
            </p>
        </div>
    }
    else if (_statement is null)
    {
        <div class="exercise-state">
            <div class="display-6 mb-2">⚠️</div>
            <h5>@(IsSynthesis ? "La question n'a pas pu être préparée" : "L'exercice n'a pas pu être préparé")</h5>
            <p class="text-muted-chic">@(_error ?? "Réessayez dans un instant.")</p>
            <button class="btn btn-brand mt-2" @onclick="StartAsync">Réessayer</button>
        </div>
    }
    else
    {
        @if (IsSynthesis)
        {
            <p class="exercise-intro">
                Dernière étape : une seule question, pour voir ce que vous retenez de ce cours.
            </p>
        }

        <section class="exercise-statement">
            <MarkdownViewer Content="@_statement" />
        </section>

        @if (_correction is null)
        {
            <div class="exercise-answer">
                <label class="exercise-label" for="exercise-answer">
                    @(IsSynthesis ? "Ce que vous en retenez" : "Votre réponse")
                </label>
                <textarea id="exercise-answer"
                          class="exercise-input"
                          rows="10"
                          placeholder="@AnswerPlaceholder"
                          @bind="_answer"
                          @bind:event="oninput"
                          disabled="@_correcting"></textarea>

                <div class="exercise-actions">
                    <span class="text-muted-chic small">
                        @if (_answer.Length > 0)
                        {
                            <text>@_answer.Length caractères</text>
                        }
                        else if (IsSynthesis)
                        {
                            <text>Avec vos mots à vous : c'est votre compréhension qu'on regarde, pas votre mémoire.</text>
                        }
                        else
                        {
                            <text>Prenez le temps : la correction détaillera ce qui manque.</text>
                        }
                    </span>

                    <button class="btn btn-brand"
                            disabled="@(_correcting || string.IsNullOrWhiteSpace(_answer))"
                            @onclick="SubmitAsync">
                        @if (_correcting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <text>Correction en cours…</text>
                        }
                        else
                        {
                            <text>Valider ma réponse</text>
                        }
                    </button>
                </div>
            </div>
        }
        else
        {
            var correction = _correction;

            <div class="exercise-correction @(correction.Acquis ? "is-acquired" : "is-partial")">
                <div class="exercise-verdict">
                    <span class="exercise-verdict-badge">@(correction.Acquis ? "✓" : "◐")</span>
                    <div>
                        <p class="exercise-verdict-title">@VerdictTitle(correction.Acquis)</p>
                        @if (correction.Conseil is { Length: > 0 } conseil)
                        {
                            <p class="exercise-verdict-hint">@conseil</p>
                        }
                    </div>
                </div>

                @if (correction.PointsForts.Count > 0)
                {
                    <div class="exercise-points is-strong">
                        <p class="exercise-points-title">
                            @(IsSynthesis ? "Ce que vous avez bien vu" : "Ce que vous avez réussi")
                        </p>
                        <ul>
                            @foreach (var point in correction.PointsForts)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    </div>
                }

                @if (correction.PointsManquants.Count > 0)
                {
                    <div class="exercise-points is-missing">
                        <p class="exercise-points-title">Ce qui manque</p>
                        <ul>
                            @foreach (var point in correction.PointsManquants)
                            {
                                <li>@point</li>
                            }
                        </ul>
                    </div>
                }

                <details class="exercise-solution" open="@(!correction.Acquis)">
                    <summary>@(IsSynthesis ? "Voir ce qu'on attendait" : "Voir la correction attendue")</summary>
                    <MarkdownViewer Content="@correction.Correction" />
                </details>

                <div class="exercise-correction-actions">
                    <button class="btn btn-sm btn-brand-outline" @onclick="AskTutorAsync">
                        <i class="bi bi-chat-dots"></i> Demander au répétiteur
                    </button>
                    <button class="btn btn-sm btn-brand-outline" @onclick="RetryAsync">
                        @(IsSynthesis ? "Répondre à une autre question" : "Refaire un exercice")
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public CourseDto Course { get; set; } = null!;
    [Parameter, EditorRequired] public StepDto Step { get; set; } = null!;

    [Parameter] public EventCallback<StepResultRequest> OnCompleted { get; set; }
    [Parameter] public EventCallback<string> OnAskTutor { get; set; }

    private bool _loading = true;
    private bool _correcting;
    private string? _error;

    private string? _statement;
    private string _answer = "";
    private ExerciseCorrection? _correction;

    private Guid _loadedStepId;

    private bool IsSynthesis => Step.IsSynthesis;

    // Extraits en propriétés : un littéral de chaîne imbriqué dans un attribut Razor
    // n'est pas analysable de façon fiable.
    private string RootClass => IsSynthesis ? "exercise is-synthesis" : "exercise";

    private string AnswerPlaceholder => IsSynthesis
        ? "Expliquez avec vos mots — quelques lignes suffisent…"
        : "Rédigez votre raisonnement, étape par étape…";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedStepId == Step.Id) return;

        _loadedStepId = Step.Id;
        await StartAsync();
    }

    private async Task StartAsync()
    {
        _loading = true;
        _error = null;
        _statement = null;
        _answer = "";
        _correction = null;
        StateHasChanged();

        // La synthèse ignore volontairement HeadingPath : elle interroge le cours
        // entier, même quand le parcours a été découpé en parties.
        _statement = IsSynthesis
            ? await Api.GenerateSynthesisAsync(Course.Id)
            : await Api.GenerateExerciseAsync(Course.Id, Step.HeadingPath);

        if (_statement is null)
            _error = IsSynthesis
                ? "La question de synthèse n'a pas pu être formulée."
                : "Le générateur d'exercices n'a rien renvoyé.";

        _loading = false;
    }

    private async Task SubmitAsync()
    {
        if (_statement is null || string.IsNullOrWhiteSpace(_answer) || _correcting) return;

        _correcting = true;
        var answer = _answer.Trim();
        _correction = await Api.CorrectExerciseAsync(Course.Id, Step.HeadingPath, _statement, answer);
        _correcting = false;

        if (_correction is null)
        {
            _error = "La correction n'a pas pu être établie.";
            return;
        }

        // Le score de l'agent est sur 100 : on le remonte tel quel, le seuil de
        // validation est appliqué côté API comme pour les QCM.
        //
        // On joint la réponse rédigée et ce que la correction en a dit : sur la
        // question de synthèse, c'est le signal le plus parlant du suivi parental —
        // l'enfant explique son cours avec ses mots, et on sait ce qui manquait.
        await OnCompleted.InvokeAsync(new StepResultRequest(
            _correction.Score,
            100,
            null,
            answer,
            SummarizeCorrection(_correction)));
    }

    /// <summary>Un nouvel énoncé sur la même étape, pour retravailler la notion.</summary>
    private Task RetryAsync() => StartAsync();

    private async Task AskTutorAsync()
    {
        if (_statement is null) return;

        var manquants = _correction?.PointsManquants ?? [];
        var detail = manquants.Count > 0
            ? $" On m'a dit qu'il me manquait : {string.Join(" ; ", manquants)}."
            : "";

        await OnAskTutor.InvokeAsync(IsSynthesis
            ? $"On m'a demandé : « {Shorten(_statement)} ».{detail} Peux-tu m'aider à voir ce que ce cours dit dans son ensemble ?"
            : $"J'ai fait cet exercice : « {Shorten(_statement)} ».{detail} Peux-tu m'expliquer ce que je n'ai pas compris ?");
    }

    private string VerdictTitle(bool acquis) => (IsSynthesis, acquis) switch
    {
        (true, true) => "Vous avez saisi l'essentiel",
        (true, false) => "L'essentiel n'est pas encore là",
        (false, true) => "C'est acquis",
        (false, false) => "Partiellement acquis",
    };

    /// <summary>
    /// Une ou deux phrases sur ce que vaut la réponse, telles qu'un parent peut les
    /// lire sans contexte. On reprend le conseil de la correction quand il existe,
    /// sinon le premier point manquant — jamais le corrigé entier, qui n'apprendrait
    /// rien sur l'enfant.
    /// </summary>
    private string SummarizeCorrection(ExerciseCorrection correction)
    {
        var verdict = (IsSynthesis, correction.Acquis) switch
        {
            (true, true) => "L'essentiel du cours est compris.",
            (true, false) => "L'essentiel du cours n'est pas encore compris.",
            (false, true) => "L'exercice est réussi.",
            (false, false) => "L'exercice n'est que partiellement réussi.",
        };

        var detail = correction.Conseil is { Length: > 0 } conseil
            ? conseil.Trim()
            : correction.PointsManquants.FirstOrDefault()?.Trim();

        var summary = detail is { Length: > 0 } ? $"{verdict} {detail}" : verdict;

        return summary.Length <= 400 ? summary : summary[..400].TrimEnd() + "…";
    }

    private static string Shorten(string value) =>
        value.Length <= 300 ? value : value[..300] + "…";
}
