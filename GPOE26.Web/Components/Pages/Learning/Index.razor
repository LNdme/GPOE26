@page "/learning"
@rendermode InteractiveServer

<PageTitle>Apprentissage – GPOE26</PageTitle>

<main class="learning-page study-page">
    <div class="container">
        <section class="learning-hero">
            <div class="learning-hero__copy">
                <span class="home-eyebrow">Votre espace d’apprentissage</span>
                <h1>Progressez à votre rythme.</h1>
                <p>Retrouvez vos cours, échangez avec l’assistant IA et vérifiez vos acquis avec des quiz.</p>
                <a href="/cours" class="learning-hero__link">Parcourir mes cours <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="learning-hero__image">
                <img src="/images/future-learning.webp" alt="Illustration d’une exploratrice tournée vers l’avenir de l’apprentissage" />
            </div>
        </section>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement de vos cours…</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="listing-state" role="alert">
                <h2>Vos cours ne sont pas disponibles</h2>
                <p>@_error</p>
                <button type="button" class="listing-create-button mt-2" @onclick="LoadCourses">Réessayer</button>
            </div>
        }
        else if (!_courses.Any())
        {
            <div class="listing-state learning-empty">
                <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                <h2>Vous n’avez pas encore de cours</h2>
                <p>Créez ou importez un cours pour commencer à apprendre avec l’assistant IA.</p>
                <a href="/cours/create" class="listing-create-button mt-2">Créer un cours</a>
            </div>
        }
        else
        {
            <div class="home-section-heading learning-section-heading">
                <div>
                    <span class="home-eyebrow home-eyebrow--dark">Reprendre là où vous en étiez</span>
                    <h2>Mes cours</h2>
                </div>
                <a href="/cours" class="home-section-link">Gérer mes cours <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="row g-4">
                @foreach (var c in _courses)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="content-card learning-course-card">
                            <div class="content-card__image content-card__image--illustration">
                                <img src="@CourseImage(c)" alt="" loading="lazy" />
                            </div>
                            <div class="content-card__body">
                                <span class="content-tag align-self-start">@c.Subject</span>
                                <h2>@c.Title</h2>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <p class="content-card__description">@Truncate(c.Description, 120)</p>
                                }
                                <div class="content-card__details">
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> Ajouté le @c.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="content-card__actions">
                                    <a href="@($"/learning/course/{c.Id}")" class="content-card__primary-link">
                                        Commencer l’étude <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</main>

@code {
    private bool _loading = true;
    private string? _error;
    private List<CourseSummaryDto> _courses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        _loading = true;
        _error = null;
        try { _courses = await Api.GetMyCoursesAsync(); }
        catch { _error = "Vérifiez votre connexion puis réessayez."; }
        finally { _loading = false; }
    }

    private static string Truncate(string t, int m) => t.Length <= m ? t : t[..m] + "…";

    private static string CourseImage(CourseSummaryDto course)
    {
        var subject = course.Subject?.ToLowerInvariant() ?? string.Empty;
        return subject.Contains("science") || subject.Contains("math") || subject.Contains("phys")
            ? "/images/future-learning.webp"
            : "/images/digital-learning.webp";
    }
}
