@page "/learning/quiz/{CourseId:guid}"
@rendermode InteractiveServer

<PageTitle>Quiz – GPOE26</PageTitle>

<main class="study-page quiz-page">
<div class="container py-5">
    <div class="quiz-container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/learning" class="text-brand-dark text-decoration-none">Apprentissage</a></li>
                <li class="breadcrumb-item"><a href="@($"/learning/course/{CourseId}")" class="text-brand-dark text-decoration-none">Cours</a></li>
                <li class="breadcrumb-item active">Quiz</li>
            </ol>
        </nav>

        @if (_loadingCourse)
        {
            <section class="quiz-state" role="status" aria-live="polite">
                <div class="quiz-skeleton"></div><div class="quiz-skeleton quiz-skeleton--short"></div>
                <p>Chargement du cours…</p>
            </section>
        }
        else if (_course is null)
        {
            <section class="quiz-panel quiz-message">
                <span class="quiz-kicker">Apprentissage</span><h1>@(_error is null ? "Cours introuvable" : "Cours indisponible")</h1>
                <p>@(_error ?? "Ce cours n’existe pas ou vous n’y avez pas accès.")</p>
                <a href="/learning" class="study-button">Retour à mes cours</a>
            </section>
        }
        else if (_generating)
        {
            <section class="quiz-panel quiz-message" role="status" aria-live="polite">
                <span class="quiz-kicker">Préparation</span><h1>Votre quiz se prépare</h1>
                <p>Quelques instants pour créer des questions à partir du cours.</p>
                <div class="quiz-skeleton"></div><div class="quiz-skeleton quiz-skeleton--short"></div>
            </section>
        }
        else if (_quiz is null)
        {
            <section class="quiz-panel quiz-setup">
                <span class="quiz-kicker">Réviser autrement</span>
                <h1>Un quiz, une idée à la fois.</h1>
                <p class="quiz-course-name">@_course.Title</p>
                @if (!string.IsNullOrEmpty(_error)) { <div class="study-alert" role="alert">@_error</div> }
                @if (string.IsNullOrWhiteSpace(_course.ExtractedText))
                {
                    <div class="study-alert" role="status">Le contenu du cours est nécessaire pour créer un quiz.</div>
                }
                <div class="quiz-setup__controls">
                    <label for="question-count">Nombre de questions</label>
                    <select id="question-count" class="form-select" @bind="_numQuestions">
                        <option value="1">1 question</option><option value="2">2 questions</option>
                        <option value="3">3 questions</option><option value="5">5 questions</option><option value="10">10 questions</option>
                    </select>
                </div>
                <button class="study-button" @onclick="GenerateQuiz" disabled="@string.IsNullOrWhiteSpace(_course.ExtractedText)">Générer mon quiz</button>
            </section>
        }
        else if (_results is null)
        {
            var current = _quiz.Questions[_currentQuestionIndex];
            <section class="quiz-panel quiz-question-panel">
                <div class="quiz-question-top">
                    <div><span class="quiz-kicker">@_quiz.Title</span><h1>À vous de jouer.</h1></div>
                    <span class="quiz-counter">@(_currentQuestionIndex + 1) <span>/ @_quiz.Questions.Count</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(_error)) { <div class="study-alert" role="alert">@_error</div> }
                <div class="quiz-progress" role="progressbar" aria-label="Progression du quiz"
                     aria-valuenow="@(_currentQuestionIndex + 1)" aria-valuemin="1" aria-valuemax="@_quiz.Questions.Count">
                    <span style="width:@($"{100.0 * (_currentQuestionIndex + 1) / _quiz.Questions.Count:0.##}%")"></span>
                </div>
                <div class="quiz-question">
                    <span class="quiz-question-number">QUESTION @(_currentQuestionIndex + 1)</span>
                    <h2>@current.Text</h2>
                </div>
                <div class="quiz-options" role="group" aria-label="Choisissez une réponse">
                    @for (int j = 0; j < current.Options.Count; j++)
                    {
                        var optionIndex = j;
                        var selected = _answers.TryGetValue(current.Id, out var answer) && answer == optionIndex;
                        <button type="button" class="option-btn @(selected ? "selected" : "")"
                                aria-pressed="@selected" @onclick="() => SelectOption(current.Id, optionIndex)">
                            <span class="option-letter">@((char)('A' + optionIndex))</span>
                            <span>@current.Options[optionIndex]</span>
                            @if (selected) { <span class="option-check" aria-hidden="true">Sélectionnée</span> }
                        </button>
                    }
                </div>
                <div class="quiz-navigation">
                    <button type="button" class="study-button study-button--quiet" @onclick="PreviousQuestion" disabled="@(_currentQuestionIndex == 0)">
                        Précédente
                    </button>
                    @if (_currentQuestionIndex < _quiz.Questions.Count - 1)
                    {
                        <button type="button" class="study-button" @onclick="NextQuestion">Question suivante</button>
                    }
                    else
                    {
                        <button type="button" class="study-button" @onclick="SubmitQuiz"
                                disabled="@(_submitting || _answers.Count < _quiz.Questions.Count)">
                            @if (_submitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Terminer le quiz
                        </button>
                    }
                </div>
                <p class="quiz-completion-note" aria-live="polite">
                    @if (_answers.Count < _quiz.Questions.Count)
                    { <span>@_answers.Count sur @_quiz.Questions.Count réponses · répondez à chaque question avant de terminer.</span> }
                    else { <span>Toutes vos réponses sont prêtes.</span> }
                </p>
            </section>
        }
        else
        {
            <section class="quiz-result-hero">
                <span class="quiz-kicker">Votre bilan</span>
                <div class="score-circle @GetScoreClass(_results.Percentage)">@_results.Score <span>/ @_results.Total</span></div>
                <h1>@GetScoreMessage(_results.Percentage)</h1>
                <p>Vous avez obtenu <strong>@_results.Percentage.ToString("F0") %</strong></p>
            </section>
            <section class="quiz-feedback">
                <div class="quiz-feedback-heading"><span class="quiz-kicker">Pour progresser</span><h2>Correction détaillée</h2></div>
                @foreach (var fb in _results.Feedbacks)
                {
                    <article class="feedback-card @(fb.IsCorrect ? "is-correct" : "is-incorrect")">
                        <div class="feedback-status">@((fb.IsCorrect ? "Réponse juste" : "À revoir"))</div>
                        <h3>@fb.QuestionText</h3>
                        @if (!fb.IsCorrect)
                        {
                            <p>Votre réponse : option @((char)('A' + fb.SelectedOptionIndex))</p>
                            <p class="feedback-correct-answer">Bonne réponse : option @((char)('A' + fb.CorrectOptionIndex))</p>
                        }
                        <p class="feedback-explanation">@fb.Explanation</p>
                    </article>
                }
                <div class="quiz-result-actions">
                    <button class="study-button study-button--quiet" @onclick="ResetQuiz">Refaire un quiz</button>
                    <a href="@($"/learning/course/{CourseId}")" class="study-button">Retour au cours</a>
                </div>
            </section>
        }
    </div>
</div>
</main>

@code {
    [Parameter] public Guid CourseId { get; set; }

    private CourseDto? _course;
    private GenerateQuizResponse? _quiz;
    private SubmitAnswersResponse? _results;
    private Dictionary<Guid, int> _answers = new();
    private bool _loadingCourse = true, _generating, _submitting;
    private int _numQuestions = 5;
    private int _currentQuestionIndex;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _loadingCourse = true;
        try { _course = await Api.GetCourseAsync(CourseId); }
        catch { _error = "Vérifiez votre connexion puis réessayez."; }
        finally { _loadingCourse = false; }
    }

    private async Task GenerateQuiz()
    {
        if (_course is null || string.IsNullOrEmpty(_course.ExtractedText)) return;
        _generating = true; _error = null;
        StateHasChanged();

        try { _quiz = await Api.GenerateQuizAsync(_course.Title, _course.ExtractedText, _numQuestions); }
        catch { _quiz = null; }
        _generating = false;

        if (_quiz is null || _quiz.Questions.Count == 0)
        {
            _quiz = null;
            _error = "Erreur lors de la génération du quiz par l'IA.";
        }
    }

    private void SelectOption(Guid questionId, int optionIndex)
    {
        _answers[questionId] = optionIndex;
    }

    private void NextQuestion()
    {
        if (_quiz is not null && _currentQuestionIndex < _quiz.Questions.Count - 1)
            _currentQuestionIndex++;
    }

    private void PreviousQuestion()
    {
        if (_currentQuestionIndex > 0) _currentQuestionIndex--;
    }

    private async Task SubmitQuiz()
    {
        if (_quiz is null) return;
        _submitting = true;
        StateHasChanged();

        var studentAnswers = _answers.Select(kv => new StudentAnswer(kv.Key, kv.Value)).ToList();
        try
        {
            _results = await Api.SubmitQuizAnswersAsync(_quiz.QuizId, studentAnswers);
            if (_results is null) _error = "La correction n’a pas pu être chargée. Réessayez.";
        }
        catch { _error = "La correction n’a pas pu être chargée. Vérifiez votre connexion et réessayez."; }
        _submitting = false;
    }

    private void ResetQuiz()
    {
        _quiz = null;
        _results = null;
        _answers.Clear();
        _currentQuestionIndex = 0;
        _error = null;
    }

    private static string GetScoreClass(double pct) => pct switch
    {
        >= 70 => "score-good",
        >= 40 => "score-ok",
        _ => "score-bad"
    };

    private static string GetScoreMessage(double pct) => pct switch
    {
        >= 90 => "Excellent travail.",
        >= 70 => "Très bon travail.",
        >= 50 => "Un bon début.",
        >= 30 => "Encore quelques notions à revoir.",
        _ => "Chaque essai vous fait progresser."
    };
}
