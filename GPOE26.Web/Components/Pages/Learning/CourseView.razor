@page "/learning/course/{Id:guid}"
@rendermode InteractiveServer
@inject GPOE26.Web.Services.ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_course?.Title ?? "Cours") – GPOE26</PageTitle>

<div id="reading-progress-bar" class="reading-progress-bar" style="width:0%"></div>

<main class="study-page course-reading-page">
<div class="container-fluid study-layout py-4 px-4">
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-navy mb-3" style="width:3rem;height:3rem;"></div>
            <p class="text-muted">Chargement du cours...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="study-load-error" role="alert">
            <h1>Le cours n’a pas pu être chargé</h1>
            <p>@_loadError</p>
            <a href="/learning" class="btn btn-navy">Retour à mes cours</a>
        </div>
    }
    else if (_course is null)
    {
        <div class="alert alert-warning text-center rounded-4 shadow-sm">
            <h4>Cours introuvable</h4>
            <p class="text-muted mb-3">Ce cours n'existe pas ou vous n'y avez pas accès.</p>
            <a href="/learning" class="btn btn-navy">Retour au dashboard</a>
        </div>
    }
    else
    {
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/learning" class="text-navy text-decoration-none">Apprentissage</a></li>
                <li class="breadcrumb-item active">@_course.Title</li>
            </ol>
        </nav>

        <div class="row g-4 study-columns">
            <!-- ── Contenu du cours ─────────────────────────────── -->
            <div class="col-lg-7">
                <article class="card-clean study-reading-card p-4 p-lg-5">

                    <!-- En-tête -->
                    <div class="d-flex justify-content-between align-items-start mb-3 gap-2 flex-wrap">
                        <div>
                            <h1 class="fw-bold mb-2 study-title">
                                @_course.Title
                            </h1>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="course-meta-badge subject">@_course.Subject</span>
                                <span class="course-meta-badge date">@_course.CreatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                        <a href="/learning/quiz/@_course.Id" class="btn btn-navy btn-sm flex-shrink-0">
                            Faire le quiz
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(_course.Description))
                    {
                        <p class="study-description mb-4">
                            @_course.Description
                        </p>
                    }

                    <hr class="mb-4" />

                    <!-- Table des matières -->
                    @if (!string.IsNullOrWhiteSpace(_courseMarkdown))
                    {
                        <GPOE26.Web.Components.UI.TableOfContents Markdown="@_courseMarkdown" />
                    }

                    <!-- Contenu Markdown -->
                    <div class="course-content">
                        @if (!string.IsNullOrWhiteSpace(_courseMarkdown))
                        {
                            <GPOE26.Web.Components.UI.MarkdownViewer Content="@_courseMarkdown" />
                        }
                        else if (!string.IsNullOrWhiteSpace(_course.ExtractedText))
                        {
                            <div class="study-extracted-text">
                                @_course.ExtractedText
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <p class="mt-3">Aucun contenu disponible pour ce cours.</p>
                            </div>
                        }
                    </div>
                </article>
            </div>

            <!-- ── Chat IA ─────────────────────────────────────── -->
            <div class="col-lg-5">
                <div class="chat-panel">
                    <div class="chat-header">
                        <span class="tutor-mark" aria-hidden="true">IA</span>
                        <div><h5>Tuteur IA</h5>
                        <p>Posez vos questions sur le cours, l'IA utilise le contenu comme contexte</p>
                        </div>
                    </div>

                    <div class="chat-messages" id="chatMessages">
                        @if (!_messages.Any())
                        {
                            <div class="chat-empty">
                                <div class="tutor-empty-mark" aria-hidden="true">?</div>
                                <p class="fw-semibold mb-1">Commencez la conversation</p>
                                <p class="small">Posez n'importe quelle question sur le cours</p>
                            </div>
                        }

                        @foreach (var msg in _messages)
                        {
                            <div class="msg-row @(msg.Role == "user" ? "user" : "")">
                                <div>
                                    <div class="msg-label @(msg.Role == "user" ? "user-label" : "ai-label")">
                                        @(msg.Role == "user" ? "Vous" : "IA")
                                    </div>
                                    @if (msg.Role == "user")
                                    {
                                        <div class="msg-bubble user-msg">@msg.Content</div>
                                    }
                                    else
                                    {
                                        <div class="msg-bubble ai-msg p-2">
                                            <GPOE26.Web.Components.UI.MarkdownViewer Content="@msg.Content" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (_chatting)
                        {
                            <div class="msg-row">
                                <div>
                                    <div class="msg-label ai-label">IA</div>
                                    <div class="typing-indicator">
                                        <div class="dot"></div><div class="dot"></div><div class="dot"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="chat-input-area">
                        <div class="input-group">
                        <input type="text" class="form-control" placeholder="Posez votre question..." aria-label="Votre question au tuteur IA"
                                   @bind="_chatInput" @bind:event="oninput"
                                   @onkeydown="HandleChatKeyDown"
                                   disabled="@_chatting" />
                            <button class="btn-send" @onclick="SendChat"
                                    disabled="@(_chatting || string.IsNullOrWhiteSpace(_chatInput))">
                                Envoyer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
</main>

@code {
    [Parameter] public Guid Id { get; set; }

    private CourseDto? _course;
    private bool _loading = true;
    private string? _loadError;
    private List<ConversationMessage> _messages = new();
    private string _chatInput = "";
    private bool _chatting;
    private string _courseMarkdown = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _course = await Api.GetCourseAsync(Id);
            if (_course is not null)
                _courseMarkdown = BuildCourseMarkdown(_course);
        }
        catch { _loadError = "Vérifiez votre connexion puis réessayez."; }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("markdownInterop.initReadingProgress"); } catch { }
        }
    }

    private async Task HandleChatKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_chatInput) && !_chatting)
            await SendChat();
    }

    private async Task SendChat()
    {
        if (string.IsNullOrWhiteSpace(_chatInput) || _course is null) return;

        var userMsg = _chatInput.Trim();
        _chatInput = "";
        _chatting = true;
        StateHasChanged();

        try
        {
            var response = await Api.SendChatMessageAsync(
                userMsg,
                _messages,
                _course.ExtractedText,
                _course.Id.ToString()
            );

            _messages = response is not null
                ? response.UpdatedHistory
                : [.. _messages, new ConversationMessage("assistant", "Désolé, une erreur s'est produite lors de la connexion à l'IA.")];
        }
        catch
        {
            _messages.Add(new ConversationMessage("assistant", "Erreur réseau ou service IA indisponible. Veuillez réessayer plus tard."));
        }
        finally
        {
            _chatting = false;
            await JS.InvokeVoidAsync("eval",
                "setTimeout(() => { const el = document.getElementById('chatMessages'); if(el) el.scrollTop = el.scrollHeight; }, 50)");
        }
    }

    private static string BuildCourseMarkdown(CourseDto course)
    {
        if (course.Sections is { Count: > 0 })
        {
            if (course.Sections.Count == 1 && course.Sections[0].Type == SectionType.Paragraph)
                return course.Sections[0].Content;

            var sb = new System.Text.StringBuilder();
            foreach (var sec in course.Sections.OrderBy(s => s.Order))
            {
                switch (sec.Type)
                {
                    case SectionType.Heading:
                        sb.AppendLine($"{new string('#', sec.Level > 0 ? sec.Level : 1)} {sec.Content}\n");
                        break;
                    case SectionType.Paragraph:
                        sb.AppendLine($"{sec.Content}\n");
                        break;
                    case SectionType.Image:
                        sb.AppendLine($"![Illustration]({sec.Content})\n");
                        break;
                }
            }
            return sb.ToString().Trim();
        }

        return course.ExtractedText ?? "";
    }
}
