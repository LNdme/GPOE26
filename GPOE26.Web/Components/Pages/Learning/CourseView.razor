@page "/learning/course/{Id:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using GPOE26.Web.Components.UI
@inject GPOE26.Web.Services.ApiClient Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(_course?.Title ?? "Étude") – GPOE26</PageTitle>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-brand-dark"></div>
        <p class="text-muted-chic mt-2">Ouverture du cours…</p>
    </div>
}
else if (_course is null)
{
    <div class="container py-5 text-center">
        <div class="display-1 mb-3">🔍</div>
        <h4 class="mb-3">Cours introuvable</h4>
        <a href="/learning" class="btn btn-brand">Retour à l'espace d'apprentissage</a>
    </div>
}
else
{
    <div class="reading-root study-shell" @ref="_rootElement">

        <div class="study-progress" aria-hidden="true">
            <div class="study-progress-bar" @ref="_progressElement"></div>
        </div>

        <header class="study-bar">
            <div class="study-bar-left">
                <a href="/learning" class="study-back" title="Retour à l'espace d'apprentissage">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div class="study-identity">
                    <span class="study-subject">@_course.Subject</span>
                    <h1 class="study-title">@_course.Title</h1>
                </div>
            </div>

            <div class="study-bar-actions">
                <button class="study-icon-btn @(_showOutline ? "is-on" : "")"
                        @onclick="() => _showOutline = !_showOutline"
                        title="Sommaire">
                    <i class="bi bi-list-nested"></i>
                </button>

                <div class="study-settings">
                    <button class="study-icon-btn @(_showSettings ? "is-on" : "")"
                            @onclick="() => _showSettings = !_showSettings"
                            title="Confort de lecture">
                        <i class="bi bi-fonts"></i>
                    </button>

                    @if (_showSettings)
                    {
                        <div class="study-popover">
                            <p class="study-popover-label">Thème</p>
                            <div class="study-choices">
                                @foreach (var theme in Themes)
                                {
                                    <button class="study-choice @(_prefs.Theme == theme.Value ? "is-active" : "")"
                                            @onclick="@(() => SetPreference("theme", theme.Value))">@theme.Label</button>
                                }
                            </div>

                            <p class="study-popover-label">Taille du texte</p>
                            <div class="study-choices">
                                @foreach (var size in Sizes)
                                {
                                    <button class="study-choice @(_prefs.Size == size.Value ? "is-active" : "")"
                                            @onclick="@(() => SetPreference("size", size.Value))">@size.Label</button>
                                }
                            </div>

                            <p class="study-popover-label">Largeur</p>
                            <div class="study-choices">
                                @foreach (var width in Widths)
                                {
                                    <button class="study-choice @(_prefs.Width == width.Value ? "is-active" : "")"
                                            @onclick="@(() => SetPreference("width", width.Value))">@width.Label</button>
                                }
                            </div>

                            <p class="study-popover-label">Police</p>
                            <div class="study-choices">
                                <button class="study-choice @(_prefs.Font == "sans" ? "is-active" : "")"
                                        @onclick="@(() => SetPreference("font", "sans"))">Sans serif</button>
                                <button class="study-choice study-choice-serif @(_prefs.Font == "serif" ? "is-active" : "")"
                                        @onclick="@(() => SetPreference("font", "serif"))">Serif</button>
                            </div>
                        </div>
                    }
                </div>

                <a href="/learning/quiz/@_course.Id" class="btn btn-brand btn-sm">
                    <i class="bi bi-bullseye"></i> Quiz
                </a>

                <button class="study-icon-btn @(_showTutor ? "is-on" : "")"
                        @onclick="() => _showTutor = !_showTutor"
                        title="Répétiteur">
                    <i class="bi bi-chat-dots"></i>
                </button>
            </div>
        </header>

        @if (_journey is not null && _journey.Steps.Count > 0)
        {
            <JourneyBar Journey="_journey" CurrentStep="_step" OnSelect="GoToStepAsync" />
        }

        <div class="study-body @(_showOutline ? "" : "no-outline") @(_showTutor ? "" : "no-tutor")">

            <!-- ── Rail gauche : étapes du parcours, ou sommaire du cours ──── -->
            <aside class="study-rail study-outline">
                @if (_journey is { Mode: JourneyMode.PerSection, Steps.Count: > 0 })
                {
                    <p class="study-rail-title">Étapes</p>
                    <nav>
                        @foreach (var step in _journey.Steps)
                        {
                            <button type="button"
                                    class="study-step-link @StepLinkClass(step)"
                                    disabled="@step.IsLocked"
                                    title="@(step.IsLocked ? LockedHint : step.Title)"
                                    @onclick="() => GoToStepAsync(step)">
                                <span class="study-step-icon">@StepIcon(step)</span>
                                <span class="study-step-text">
                                    <span class="study-step-title">@step.Title</span>
                                    @if (step.Score is not null)
                                    {
                                        <span class="study-step-score">@step.ScoreLabel</span>
                                    }
                                </span>
                            </button>
                        }
                    </nav>
                }
                else
                {
                    <p class="study-rail-title">Sommaire</p>
                    @if (_outline.Count == 0)
                    {
                        <p class="study-rail-empty">Le sommaire apparaîtra une fois le cours mis en forme.</p>
                    }
                    else
                    {
                        <nav>
                            @foreach (var entry in _outline)
                            {
                                <button type="button"
                                        class="study-toc-link study-toc-l@(entry.Level)"
                                        data-toc-target="@entry.Id"
                                        @onclick="() => ScrollTo(entry.Id)">@entry.Text</button>
                            }
                        </nav>
                    }
                }
            </aside>

            <!-- ── Canvas de lecture ────────────────────────────────────── -->
            <main class="study-main" @ref="_scrollerElement">

                @if (_course.HasOriginalDocument)
                {
                    <div class="study-tabs">
                        <button class="study-tab @(_tab == Tab.Course ? "is-active" : "")"
                                @onclick="() => _tab = Tab.Course">Cours</button>
                        <button class="study-tab @(_tab == Tab.Original ? "is-active" : "")"
                                @onclick="() => _tab = Tab.Original">Document original</button>
                    </div>
                }

                @if (_tab == Tab.Course)
                {
                    @if (_course.FormatStatus == FormatStatus.Pending)
                    {
                        <div class="study-state">
                            <div class="spinner-border text-brand-dark mb-3"></div>
                            <h5>Mise en forme du cours en cours…</h5>
                            <p class="text-muted-chic">
                                @(_course.ContentType == ContentType.Images
                                    ? "Vos photos sont en cours de lecture, puis le cours sera structuré."
                                    : "Le cours est en cours de structuration : titres, définitions, formules.")
                            </p>
                            <p class="text-muted-chic small">Cela prend généralement moins d'une minute.</p>
                        </div>
                    }
                    else if (_course.FormatStatus == FormatStatus.Failed && string.IsNullOrWhiteSpace(_course.FormattedMarkdown))
                    {
                        <div class="study-state">
                            <div class="display-6 mb-2">⚠️</div>
                            <h5>La mise en forme a échoué</h5>
                            <p class="text-muted-chic">@(_course.FormatError ?? "Une erreur est survenue.")</p>
                            <button class="btn btn-brand mt-2" @onclick="RegenerateAsync" disabled="@_regenerating">
                                @if (_regenerating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Réessayer
                            </button>
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(_course.ReadableContent))
                    {
                        <div class="study-state">
                            <div class="display-6 mb-2">📄</div>
                            <h5>Aucun contenu disponible</h5>
                            <p class="text-muted-chic">Ce cours ne contient encore ni texte ni document.</p>
                        </div>
                    }
                    else if (_step is { IsQuiz: true } quizStep)
                    {
                        <StepQuiz Course="_course"
                                  Step="quizStep"
                                  PassThresholdPercent="_journey!.PassThresholdPercent"
                                  OnCompleted="OnStepResultAsync"
                                  OnAskTutor="AskTutorAboutAsync"
                                  OnGoToSection="ScrollToHeadingText" />
                    }
                    else if (_step is { IsOpenExercise: true } exerciseStep)
                    {
                        <StepExercise Course="_course"
                                      Step="exerciseStep"
                                      OnCompleted="OnStepResultAsync"
                                      OnAskTutor="AskTutorAboutAsync" />
                    }
                    else
                    {
                        @if (_course.FormatStatus == FormatStatus.Failed)
                        {
                            <div class="study-banner">
                                <span>⚠️ La dernière mise en forme a échoué — voici la version précédente.</span>
                                <button class="btn btn-sm btn-brand-outline" @onclick="RegenerateAsync" disabled="@_regenerating">
                                    Régénérer
                                </button>
                            </div>
                        }

                        @if (_journey?.PartLabel(_step!) is { } partLabel)
                        {
                            <p class="study-part-label">@partLabel</p>
                        }

                        <article class="course-canvas">
                            <MarkdownViewer Content="@ReadingContent" />
                        </article>

                        <footer class="study-footer">
                            <span class="text-muted-chic small">
                                @if (_course.FormattedAt is { } formattedAt)
                                {
                                    <text>Mis en forme le @formattedAt.ToLocalTime().ToString("dd MMM yyyy à HH:mm")</text>
                                }
                                else
                                {
                                    <text>Contenu d'origine, non mis en forme</text>
                                }
                            </span>
                            <button class="btn btn-sm btn-brand-outline" @onclick="RegenerateAsync" disabled="@_regenerating">
                                @if (_regenerating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-arrow-clockwise"></i> Régénérer la mise en forme
                            </button>
                        </footer>
                    }
                }
                else
                {
                    <div class="study-original">
                        @if (_course.Pdf is { } pdf)
                        {
                            <iframe class="study-pdf" src="@pdf.Url" title="Document original"></iframe>
                        }
                        else if (!string.IsNullOrEmpty(_course.PdfPath))
                        {
                            <iframe class="study-pdf" src="@("/" + _course.PdfPath.TrimStart('/'))" title="Document original"></iframe>
                        }
                        else
                        {
                            <div class="study-photos">
                                @foreach (var (photo, index) in _course.Photos.Select((p, i) => (p, i)))
                                {
                                    <figure>
                                        <img src="@photo.Url" alt="@($"Page {index + 1} du cours")" loading="lazy" />
                                        <figcaption>Page @(index + 1)</figcaption>
                                    </figure>
                                }
                            </div>
                        }
                    </div>
                }
            </main>

            <!-- ── Répétiteur ───────────────────────────────────────────── -->
            <aside class="study-rail study-tutor">
                <div class="study-tutor-head">
                    <p class="study-rail-title mb-0">Répétiteur</p>
                    <span class="study-tutor-sub">Il répond à partir de votre cours</span>
                </div>

                <div class="study-messages">
                    @if (_messages.Count == 0 && !_chatting)
                    {
                        <div class="study-tutor-empty">
                            <div class="study-tutor-emoji">💬</div>
                            <p class="fw-semibold mb-1">Posez votre première question</p>
                            <p class="small mb-3">Le répétiteur cherche la réponse dans votre cours et cite ses sources.</p>
                            <div class="study-suggestions">
                                @foreach (var suggestion in Suggestions)
                                {
                                    <button class="study-suggestion" @onclick="() => SendAsync(suggestion)">@suggestion</button>
                                }
                            </div>
                        </div>
                    }

                    @foreach (var message in _messages)
                    {
                        <div class="study-msg @(message.Role == "user" ? "is-user" : "is-ai")">
                            @if (message.Role == "user")
                            {
                                <div class="study-bubble study-bubble-user">@message.Content</div>
                            }
                            else
                            {
                                <div class="study-bubble study-bubble-ai">
                                    <MarkdownViewer Content="@message.Content" />
                                </div>
                            }
                        </div>
                    }

                    @if (_chatting)
                    {
                        <div class="study-msg is-ai">
                            <div class="study-bubble study-bubble-ai">
                                @if (!string.IsNullOrEmpty(_streamingReply))
                                {
                                    <MarkdownViewer Content="@_streamingReply" />
                                }
                                else
                                {
                                    <div class="study-step">
                                        <span class="study-step-dot"></span>
                                        <span>@(_currentStep ?? "Réflexion…")</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (_citations.Count > 0 && !_chatting)
                    {
                        <div class="study-citations">
                            <p class="study-citations-title">Passages utilisés</p>
                            @foreach (var citation in _citations)
                            {
                                <button class="study-citation" @onclick="() => ScrollToHeadingText(citation)">
                                    <i class="bi bi-bookmark"></i> @citation
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="study-composer">
                    <textarea class="study-input"
                              placeholder="Une question sur ce cours…"
                              rows="1"
                              @bind="_input"
                              @bind:event="onchange"
                              @onkeydown="HandleKeyDown"
                              disabled="@_chatting"></textarea>
                    <button class="study-send"
                            @onclick="() => SendAsync(_input)"
                            disabled="@(_chatting || string.IsNullOrWhiteSpace(_input))"
                            title="Envoyer">
                        <i class="bi bi-send"></i>
                    </button>
                </div>
            </aside>
        </div>

        @*
            Barre d'action : le fil que l'élève suit sans réfléchir. Toujours visible,
            son libellé dépend de l'étape en cours.
        *@
        @if (_journey is not null && _step is not null && _tab == Tab.Course)
        {
            <footer class="study-action">
                <span class="study-action-context">
                    @if (_step.IsLocked)
                    {
                        <text>🔒 @LockedHint</text>
                    }
                    else
                    {
                        @_step.Title
                        @if (_journey.PartLabel(_step) is { } label)
                        {
                            <span class="study-action-sub"> · @label</span>
                        }
                    }
                </span>

                @if (_step.IsReading && !_step.IsPassed)
                {
                    <button class="btn btn-brand" disabled="@(!_readingComplete || _advancing)" @onclick="MarkReadAsync">
                        @if (_advancing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @(_readingComplete ? NextLabel : "Lisez le cours jusqu'au bout")
                    </button>
                }
                else if (NextStep is { } next)
                {
                    <button class="btn btn-brand" disabled="@next.IsLocked" @onclick="() => GoToStepAsync(next)">
                        @NextLabel
                    </button>
                }
                else if (_journey.Steps.All(s => s.IsPassed))
                {
                    <span class="study-action-done">🎉 Parcours terminé</span>
                }
            </footer>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private enum Tab { Course, Original }

    private CourseDto? _course;
    private bool _loading = true;
    private bool _regenerating;
    private Tab _tab = Tab.Course;

    // Rails et réglages
    private bool _showOutline = true;
    private bool _showTutor = true;
    private bool _showSettings;
    private ReadingPreferences _prefs = new();

    // Sommaire
    private IReadOnlyList<MarkdownViewer.OutlineEntry> _outline = [];

    // Parcours
    private JourneyDto? _journey;
    private StepDto? _step;
    private bool _readingComplete;
    private bool _advancing;

    // Répétiteur
    private readonly List<ConversationMessage> _messages = [];
    private readonly List<string> _citations = [];
    private string _input = "";
    private bool _chatting;
    private string? _currentStep;
    private string _streamingReply = "";

    // Interop
    private ElementReference _rootElement;
    private ElementReference _scrollerElement;
    private ElementReference _progressElement;
    private bool _interopReady;
    private string? _renderedContent;

    /// <summary>Référence passée au JS pour qu'il signale le franchissement du seuil de lecture.</summary>
    private DotNetObjectReference<CourseView>? _selfRef;

    // Suivi de la mise en forme en tâche de fond
    private CancellationTokenSource? _pollingCts;

    private static readonly (string Value, string Label)[] Themes =
        [("light", "Clair"), ("sepia", "Sépia"), ("dark", "Sombre")];

    private static readonly (string Value, string Label)[] Sizes =
        [("sm", "Petite"), ("md", "Normale"), ("lg", "Grande"), ("xl", "Très grande")];

    private static readonly (string Value, string Label)[] Widths =
        [("narrow", "Étroite"), ("default", "Normale"), ("wide", "Large")];

    private static readonly string[] Suggestions =
    [
        "Résume-moi ce cours",
        "Explique la partie que je n'ai pas comprise",
        "Donne-moi un exercice",
    ];

    private sealed class ReadingPreferences
    {
        public string Theme { get; set; } = "light";
        public string Size { get; set; } = "md";
        public string Width { get; set; } = "default";
        public string Font { get; set; } = "sans";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        _course = await Api.GetCourseAsync(Id);
        _outline = MarkdownViewer.BuildOutline(_course?.ReadableContent);

        await LoadJourneyAsync();

        // Un cours déposé arrive en Pending : on suit son avancement pour basculer
        // automatiquement sur le contenu dès qu'il est prêt, sans que l'élève recharge.
        if (_course?.FormatStatus == FormatStatus.Pending) StartPolling();
    }

    private async Task LoadJourneyAsync()
    {
        if (_course is null) return;

        _journey = await Api.GetJourneyAsync(_course.Id);
        ApplyJourney(_journey?.Active);
    }

    /// <summary>
    /// Positionne l'étape courante et réinitialise l'état de lecture qui en dépend.
    /// Une étape déjà validée est consultable : on n'oblige personne à relire pour
    /// revenir en arrière.
    /// </summary>
    private void ApplyJourney(StepDto? step)
    {
        _step = step;
        _readingComplete = step is null || !step.IsReading || step.IsPassed;
        _outline = MarkdownViewer.BuildOutline(ReadingContent);
    }

    // ── Contenu et navigation du parcours ────────────────────────────────────

    /// <summary>
    /// Ce que le canvas affiche : le cours entier, ou la seule partie de l'étape
    /// quand le parcours se lit partie par partie.
    /// </summary>
    private string? ReadingContent =>
        _journey?.Mode == JourneyMode.PerSection && _step?.HeadingPath is { } path
            ? MarkdownViewer.ExtractPart(_course?.ReadableContent, path)
            : _course?.ReadableContent;

    private StepDto? NextStep =>
        _journey?.Steps.FirstOrDefault(s => _step is not null && s.Order > _step.Order);

    /// <summary>Message affiché sur une étape encore verrouillée.</summary>
    private string LockedHint =>
        $"Validez l'étape précédente à {(_journey?.PassThresholdPercent ?? 70):0} % pour débloquer";

    private string NextLabel => _step?.Kind switch
    {
        StepKind.Lecture when NextStep?.IsQuiz == true => "J'ai lu — passer au test",
        StepKind.Lecture => "J'ai lu — continuer",
        StepKind.MiniTest or StepKind.TestFinal when NextStep?.IsReading == true => "Partie suivante",
        StepKind.MiniTest or StepKind.TestFinal => "Passer aux exercices",
        StepKind.ExerciceOuvert => "Passer au QCM d'application",
        _ => "Continuer",
    };

    private async Task GoToStepAsync(StepDto step)
    {
        if (step.IsLocked) return;

        ApplyJourney(step);
        _tab = Tab.Course;

        // Nouveau texte à l'écran : le suivi de lecture doit repartir de zéro, sinon
        // la partie suivante serait considérée comme lue dès son ouverture.
        if (_interopReady)
        {
            _renderedContent = ReadingContent;
            await JS.InvokeVoidAsync("readingInterop.rescan", true);
        }

        StateHasChanged();
    }

    /// <summary>Appelé par reading-interop.js une seule fois, au franchissement de 90 %.</summary>
    [JSInvokable]
    public Task OnReadingThresholdReached()
    {
        if (_readingComplete) return Task.CompletedTask;

        _readingComplete = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task MarkReadAsync()
    {
        if (_course is null || _step is null || _advancing) return;

        _advancing = true;
        var updated = await Api.MarkStepReadAsync(_course.Id, _step.Id);
        _advancing = false;

        if (updated is null) return;

        _journey = updated;
        await GoToStepOrRefresh(updated.Active);
    }

    /// <summary>Résultat d'une étape évaluée, remonté par StepQuiz ou StepExercise.</summary>
    private async Task OnStepResultAsync(StepResultRequest result)
    {
        if (_course is null || _step is null) return;

        var updated = await Api.SubmitStepResultAsync(
            _course.Id, _step.Id, result.Score, result.Total, result.WeakHeadings);

        if (updated is null) return;

        _journey = updated;

        // Étape ratée : on reste dessus pour que l'élève voie sa correction et puisse
        // refaire le test. Réussie : on l'emmène à la suite.
        var current = updated.StepById(_step.Id);
        if (current is { IsPassed: false })
        {
            ApplyJourney(current);
            StateHasChanged();
            return;
        }

        await GoToStepOrRefresh(updated.Active);
    }

    private async Task GoToStepOrRefresh(StepDto? next)
    {
        if (next is not null) await GoToStepAsync(next);
        else { ApplyJourney(_journey?.Active); StateHasChanged(); }
    }

    /// <summary>
    /// Pousse une question ratée dans le rail du répétiteur, avec son contexte, pour
    /// que l'élève obtienne une explication sans avoir à la retaper.
    /// </summary>
    private async Task AskTutorAboutAsync(string question)
    {
        _showTutor = true;
        await SendAsync(question);
    }

    private static string StepLinkClass(StepDto step) => step.Status switch
    {
        StepStatus.Passed => "is-passed",
        StepStatus.Failed => "is-failed",
        StepStatus.Locked => "is-locked",
        _ => "is-open",
    };

    private string StepIcon(StepDto step)
    {
        if (step.IsPassed) return "✓";
        if (step.IsLocked) return "🔒";
        if (step.Id == _step?.Id) return "●";

        return step.Kind switch
        {
            StepKind.Lecture => "📖",
            StepKind.ExerciceOuvert => "✍️",
            _ => "🎯",
        };
    }

    // ── Suivi de la mise en forme ────────────────────────────────────────────

    private void StartPolling()
    {
        _pollingCts?.Cancel();
        _pollingCts = new CancellationTokenSource();
        var token = _pollingCts.Token;

        _ = Task.Run(async () =>
        {
            // La transcription puis la structuration prennent des dizaines de secondes ;
            // un sondage toutes les 3 s reste discret et suffit largement.
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            var attempts = 0;

            try
            {
                while (await timer.WaitForNextTickAsync(token))
                {
                    // Garde-fou : au bout de ~5 minutes, on arrête de sonder plutôt que
                    // de laisser une boucle tourner indéfiniment sur un traitement bloqué.
                    if (++attempts > 100) break;

                    var refreshed = await Api.GetCourseAsync(Id);
                    if (refreshed is null || refreshed.FormatStatus == FormatStatus.Pending) continue;

                    _course = refreshed;

                    // Les étapes du parcours sont générées à la fin de la mise en forme :
                    // il faut donc le recharger, pas seulement le contenu.
                    await LoadJourneyAsync();

                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
            catch (OperationCanceledException)
            {
                // Navigation hors de la page : rien à signaler.
            }
        }, token);
    }

    private async Task RegenerateAsync()
    {
        if (_course is null || _regenerating) return;

        _regenerating = true;
        var accepted = await Api.RequestCourseFormatAsync(_course.Id);
        _regenerating = false;

        if (!accepted) return;

        _course = _course with { FormatStatus = FormatStatus.Pending, FormatError = null };
        StartPolling();
    }

    // ── Confort de lecture ───────────────────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_course is null) return;

        if (!_interopReady)
        {
            _interopReady = true;
            _selfRef = DotNetObjectReference.Create(this);

            var prefs = await JS.InvokeAsync<ReadingPreferences>(
                "readingInterop.init", Id.ToString(), _rootElement, _scrollerElement, _progressElement, _selfRef);

            if (prefs is not null)
            {
                _prefs = prefs;
                StateHasChanged();
            }

            _renderedContent = ReadingContent;
            return;
        }

        // Le contenu a changé (fin de la mise en forme, ou changement d'étape) : les
        // titres et les liens du sommaire sont de nouveaux nœuds DOM, l'interop doit
        // les retrouver. On ne réarme pas le seuil de lecture ici — GoToStepAsync s'en
        // charge, lui seul sait qu'il s'agit d'un nouveau texte à lire.
        if (_renderedContent != ReadingContent)
        {
            _renderedContent = ReadingContent;
            await JS.InvokeVoidAsync("readingInterop.rescan", false);
        }
    }

    private async Task SetPreference(string key, string value)
    {
        var prefs = await JS.InvokeAsync<ReadingPreferences>(
            "readingInterop.setPreference", _rootElement, key, value);

        if (prefs is not null) _prefs = prefs;
    }

    private async Task ScrollTo(string headingId) =>
        await JS.InvokeVoidAsync("readingInterop.scrollToHeading", _scrollerElement, headingId);

    /// <summary>
    /// Amène l'élève au passage cité par le répétiteur. La citation est un chemin de
    /// titres (« Les dérivées › Nombre dérivé ») : on cible le dernier segment, qui
    /// correspond au titre le plus profond.
    /// </summary>
    private async Task ScrollToHeadingText(string headingPath)
    {
        var leaf = headingPath.Split('›').LastOrDefault()?.Trim();
        if (string.IsNullOrEmpty(leaf)) return;

        var match = _outline.FirstOrDefault(e =>
            string.Equals(e.Text, leaf, StringComparison.OrdinalIgnoreCase));

        if (match is not null) await ScrollTo(match.Id);
    }

    // ── Répétiteur ───────────────────────────────────────────────────────────

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        // Entrée envoie, Maj+Entrée passe à la ligne — convention attendue d'un chat.
        if (e.Key == "Enter" && !e.ShiftKey && !_chatting && !string.IsNullOrWhiteSpace(_input))
            await SendAsync(_input);
    }

    private async Task SendAsync(string message)
    {
        if (_course is null || _chatting || string.IsNullOrWhiteSpace(message)) return;

        var question = message.Trim();
        _input = "";
        _citations.Clear();
        _streamingReply = "";
        _currentStep = null;
        _chatting = true;

        // L'historique envoyé s'arrête AVANT la question courante : le pipeline la
        // rajoute lui-même en dernier tour. L'inclure ici la ferait apparaître deux fois
        // dans le prompt.
        var history = _messages.ToList();

        _messages.Add(new ConversationMessage("user", question));
        StateHasChanged();

        try
        {
            await foreach (var evt in Api.StreamTutorAsync(_course.Id, question, history))
            {
                switch (evt.Type)
                {
                    case "step":
                        _currentStep = evt.Step;
                        break;

                    case "token":
                        _streamingReply += evt.Token;
                        break;

                    case "done":
                        // Reply fait autorité sur le texte streamé : si le Relecteur a
                        // imposé une révision, c'est la version corrigée qui arrive ici.
                        _messages.Add(new ConversationMessage("assistant",
                            string.IsNullOrWhiteSpace(evt.Reply) ? _streamingReply : evt.Reply!));

                        if (evt.Citations is { Count: > 0 }) _citations.AddRange(evt.Citations);

                        // Le pipeline continue après « done » (mise à jour de la fiche de
                        // suivi) : on rend la main tout de suite, sinon l'indicateur de
                        // frappe resterait affiché pour un travail que l'élève n'attend pas.
                        _chatting = false;
                        _streamingReply = "";
                        _currentStep = null;
                        break;

                    case "error":
                        _messages.Add(new ConversationMessage("assistant",
                            evt.Error ?? "Une erreur est survenue. Réessayez dans un instant."));

                        _chatting = false;
                        _streamingReply = "";
                        break;
                }

                StateHasChanged();
            }
        }
        catch (Exception)
        {
            _messages.Add(new ConversationMessage("assistant",
                "⚠️ Le répétiteur est momentanément injoignable. Réessayez dans un instant."));
        }
        finally
        {
            _chatting = false;
            _streamingReply = "";
            _currentStep = null;
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _pollingCts?.Cancel();
        _pollingCts?.Dispose();

        try
        {
            if (_interopReady) await JS.InvokeVoidAsync("readingInterop.dispose");
        }
        catch (JSDisconnectedException)
        {
            // Le circuit est déjà fermé : il n'y a plus de navigateur à nettoyer.
        }
        finally
        {
            // À libérer dans tous les cas : la référence maintient le composant en vie
            // côté .NET tant qu'elle n'est pas disposée.
            _selfRef?.Dispose();
        }
    }
}
