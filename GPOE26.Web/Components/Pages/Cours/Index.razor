@page "/cours"
@rendermode InteractiveServer

<PageTitle>Mes Cours – GPOE26</PageTitle>

<main class="listing-page course-library-page study-page">
    <div class="container">
        <header class="listing-header">
            <div class="listing-header__copy">
                <span class="listing-eyebrow">Votre espace pédagogique</span>
                <h1 class="listing-title">Mes cours</h1>
                <p class="listing-description">Retrouvez vos ressources et reprenez votre apprentissage à votre rythme.</p>
            </div>
            <a href="/cours/create" class="listing-create-button">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Nouveau cours
            </a>
        </header>

        @if (_loading)
        {
            <div class="listing-state" role="status">
                <span class="spinner-border text-brand-dark"></span>
                <p>Chargement de vos cours…</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="listing-state" role="alert">
                <h2>La bibliothèque n’a pas pu charger</h2>
                <p>@_error</p>
                <button type="button" class="listing-create-button mt-2" @onclick="Load">Réessayer</button>
            </div>
        }
        else if (!_courses.Any())
        {
            <div class="listing-state">
                <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                <h2>Votre espace de cours est prêt</h2>
                <p>Ajoutez votre premier cours pour commencer à apprendre.</p>
                <a href="/cours/create" class="listing-create-button mt-2">Créer un cours</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var c in _courses)
                {
                    <div class="col-sm-6 col-lg-4">
                        <article class="content-card">
                            <div class="content-card__image content-card__image--illustration">
                                <img src="@CourseImage(c)" alt="" loading="lazy" />
                            </div>
                            <div class="content-card__body">
                                <div class="content-card__meta">
                                    <span class="content-tag">@c.Subject</span>
                                    <span>@(c.ContentType.ToString() == "Pdf" ? "PDF" : "Texte")</span>
                                </div>
                                <h2>@c.Title</h2>
                                @if (!string.IsNullOrWhiteSpace(c.Description))
                                {
                                    <p class="content-card__description">@Truncate(c.Description, 120)</p>
                                }
                                <div class="content-card__details">
                                    <span><i class="bi bi-clock" aria-hidden="true"></i> Ajouté le @c.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="content-card__actions">
                                    <a href="@($"/learning/course/{c.Id}")" class="content-card__primary-link">
                                        Étudier ce cours <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                    <a href="@($"/cours/edit/{c.Id}")" class="content-card__icon-action"
                                       title="Modifier le cours" aria-label="@($"Modifier {c.Title}")">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </a>
                                    <button class="content-card__icon-action content-card__icon-action--danger"
                                            title="Supprimer le cours" aria-label="@($"Supprimer {c.Title}")"
                                            @onclick="() => ConfirmDel(c)">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</main>

@if (_toDel is not null)
{
    <div class="modal d-block study-modal" tabindex="-1" style="background: rgba(0,0,0,0.68);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="delete-course-title">
                <div class="modal-header"><h5 id="delete-course-title" class="modal-title">Confirmer la suppression</h5><button type="button" class="btn-close" aria-label="Fermer" @onclick="CancelDel"></button></div>
                <div class="modal-body">
                    <p>Supprimer <strong>@_toDel.Title</strong> ?</p>
                    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="study-alert" role="alert">@_error</div> }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDel">Annuler</button>
                    <button class="btn btn-danger" @onclick="Del" disabled="@_deleting">
                        @if (_deleting) { <span class="spinner-border spinner-border-sm me-1"></span> } Supprimer
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true, _deleting;
    private string? _error;
    private List<CourseSummaryDto> _courses = new();
    private CourseSummaryDto? _toDel;

    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load()
    {
        _loading = true;
        _error = null;
        try { _courses = await Api.GetMyCoursesAsync(); }
        catch { _error = "Vérifiez votre connexion puis réessayez."; }
        finally { _loading = false; }
    }
    private void ConfirmDel(CourseSummaryDto c) { _error = null; _toDel = c; }
    private void CancelDel() { _error = null; _toDel = null; }
    private async Task Del()
    {
        if (_toDel is null) return;
        _deleting = true;
        _error = null;
        try
        {
            await Api.DeleteCourseAsync(_toDel.Id);
            _toDel = null;
            await Load();
        }
        catch { _error = "Le cours n’a pas pu être supprimé. Réessayez."; }
        finally { _deleting = false; }
    }

    private static string CourseImage(CourseSummaryDto course)
    {
        var subject = course.Subject?.ToLowerInvariant() ?? string.Empty;
        return subject.Contains("science") || subject.Contains("math") || subject.Contains("phys")
            ? "/images/future-learning.webp"
            : "/images/digital-learning.webp";
    }

    private static string Truncate(string t, int m) => t.Length <= m ? t : t[..m] + "…";
}
