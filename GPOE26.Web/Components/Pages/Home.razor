@page "/"
@rendermode InteractiveServer
@inject GPOE26.Web.Services.ApiClient Api
@using GPOE26.Web.Models

<PageTitle>Accueil – GPOE26</PageTitle>

<section class="home-hero">
    <div class="container home-hero__grid">
        <div class="home-hero__copy">
            <span class="home-eyebrow">Lycée Technique de Nanga-Eboko</span>
            <h1>@(_contact?.Name ?? "Apprendre, créer, réussir.")</h1>
            <p>
                Des cours, des projets et une communauté pour faire grandir vos idées et préparer votre avenir.
            </p>
            <div class="home-hero__actions">
                <a href="/register" class="btn btn-home-primary">Rejoindre la plateforme <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                <a href="/hierarchy" class="home-text-link">Découvrir l’établissement</a>
            </div>
            <div class="home-hero__note"><i class="bi bi-lightbulb" aria-hidden="true"></i> Apprendre avec curiosité et confiance</div>
        </div>
        <div class="home-hero__visual" aria-label="Illustration de deux personnes qui apprennent ensemble">
            <img src="/images/learning-together.webp" alt="Deux apprenants travaillent ensemble autour d’un ordinateur" />
            <div class="home-hero__caption">
                <span class="home-hero__caption-icon"><i class="bi bi-book-half" aria-hidden="true"></i></span>
                <span><strong>Le savoir se partage</strong><small>Une communauté qui avance ensemble</small></span>
            </div>
        </div>
    </div>
</section>

@if (_contact is not null)
{
    <section class="home-section home-about">
        <div class="container home-about__grid">
            <div class="home-about__copy">
                <span class="home-eyebrow home-eyebrow--dark">Notre établissement</span>
                <h2>Un lieu pour apprendre et construire l’avenir.</h2>
                <p>
                    Au cœur de @_contact.City, le Lycée Technique de Nanga-Eboko associe savoir-faire, accompagnement et outils numériques pour faire progresser chaque élève.
                </p>
                <div class="home-contact-list">
                    @if (!string.IsNullOrWhiteSpace(_contact.Address))
                    {
                        <span><i class="bi bi-geo-alt" aria-hidden="true"></i> @_contact.Address</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contact.Email))
                    {
                        <a href="mailto:@_contact.Email"><i class="bi bi-envelope" aria-hidden="true"></i> @_contact.Email</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contact.Phone))
                    {
                        <a href="tel:@_contact.Phone"><i class="bi bi-telephone" aria-hidden="true"></i> @_contact.Phone</a>
                    }
                </div>
            </div>
            <div class="home-about__visual">
                <img src="/images/digital-learning.webp" alt="Illustration d’une personne découvrant l’apprentissage numérique" loading="lazy" />
                <div class="home-about__label"><span>Le numérique au service de l’apprentissage</span><i class="bi bi-arrow-up-right" aria-hidden="true"></i></div>
            </div>
        </div>
    </section>
}

<section class="home-section home-news">
    <div class="container">
        <div class="home-section-heading">
            <div>
                <span class="home-eyebrow home-eyebrow--dark">À la une</span>
                <h2>Les nouvelles de l’établissement</h2>
            </div>
            <a href="/blog" class="home-section-link">Toutes les actualités <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>

        @if (_loading)
        {
            <div class="home-loading"><span class="spinner-border spinner-border-sm text-brand-dark" role="status"></span> Chargement des actualités…</div>
        }
        else if (_news.Any())
        {
            <div class="row g-4">
                @foreach (var article in _news)
                {
                    <div class="col-md-4">
                        <article class="story-card">
                            <a href="@($"/blog/details/{article.Id}")" class="story-card__image @(string.IsNullOrWhiteSpace(article.ImageUrl) ? "story-card__image--illustration" : string.Empty)" aria-label="@($"Lire l’article : {article.Title}")">
                                <img src="@(string.IsNullOrWhiteSpace(article.ImageUrl) ? "/images/learning-together.webp" : article.ImageUrl)"
                                     alt="" loading="lazy" />
                            </a>
                            <div class="story-card__body">
                                <div class="story-card__meta"><span>@article.Category</span><time>@article.CreatedAt.ToString("dd MMM yyyy")</time></div>
                                <h3><a href="@($"/blog/details/{article.Id}")">@article.Title</a></h3>
                                <p>@(article.Excerpt ?? Truncate(article.Content, 120))</p>
                                <a href="@($"/blog/details/{article.Id}")" class="story-card__link">Lire l’article <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="home-empty">Les prochaines actualités de l’établissement apparaîtront ici.</p>
        }
    </div>
</section>

<section class="home-section home-community">
    <div class="container">
        <div class="home-section-heading">
            <div>
                <span class="home-eyebrow home-eyebrow--dark">La vie au lycée</span>
                <h2>À découvrir cette semaine</h2>
            </div>
        </div>
        <div class="row g-4">
            <div class="col-lg-6">
                <div class="home-feature-panel">
                    <div class="home-feature-panel__heading">
                        <h3>Prochains événements</h3>
                        <a href="/events" aria-label="Voir tous les événements"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    </div>
                    @if (_loading)
                    {
                        <p class="home-empty">Chargement…</p>
                    }
                    else if (_events.Any())
                    {
                        <div class="home-event-list">
                            @foreach (var ev in _events.Take(3))
                            {
                                <a class="home-event" href="@($"/events/details/{ev.Id}")">
                                    <span class="home-event__date"><strong>@ev.StartDate.ToString("dd")</strong><small>@ev.StartDate.ToString("MMM")</small></span>
                                    <span class="home-event__content"><strong>@ev.Title</strong><small>@ev.Type@if (!string.IsNullOrWhiteSpace(ev.Location)) { <span> · @ev.Location</span> }</small></span>
                                    <i class="bi bi-arrow-right home-event__arrow" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-empty">Aucun événement prévu pour le moment.</p>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="home-feature-panel home-feature-panel--activities">
                    <div class="home-feature-panel__heading">
                        <h3>Clubs et activités</h3>
                        <a href="/activities" aria-label="Découvrir toutes les activités"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                    </div>
                    @if (_loading)
                    {
                        <p class="home-empty">Chargement…</p>
                    }
                    else if (_activities.Any())
                    {
                        <div class="home-activity-list">
                            @foreach (var activity in _activities.Take(3))
                            {
                                <a class="home-activity" href="@($"/activities/details/{activity.Id}")">
                                    <img src="@ActivityImage(activity)" alt="" loading="lazy" />
                                    <span><strong>@activity.Name</strong><small>@activity.Category</small></span>
                                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="home-empty">Les activités seront bientôt présentées ici.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@if (_hierarchy.Any())
{
    <section class="home-section home-team">
        <div class="container">
            <div class="home-section-heading">
                <div>
                    <span class="home-eyebrow home-eyebrow--dark">L’équipe éducative</span>
                    <h2>Les personnes qui vous accompagnent</h2>
                </div>
                <a href="/hierarchy" class="home-section-link">Rencontrer l’équipe <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            </div>
            <div class="home-team-list">
                @foreach (var member in _hierarchy.Take(4))
                {
                    <div class="home-team-member">
                        <div class="home-team-member__avatar">
                            @if (!string.IsNullOrWhiteSpace(member.ImageUrl))
                            {
                                <img src="@member.ImageUrl" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span>@(string.IsNullOrWhiteSpace(member.PreName) ? "É" : member.PreName[..1])</span>
                            }
                        </div>
                        <div><strong>@member.PreName @member.Name</strong><small>@member.Role</small></div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@code {
    private bool _loading = true;
    private Contact? _contact;
    private List<NewArticle> _news = new();
    private List<SchoolEvent> _events = new();
    private List<SchoolActivity> _activities = new();
    private List<GPOE26.Web.Models.Hierarchy> _hierarchy = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        
        var contactTask = Api.GetPrimaryContactAsync();
        var newsTask = Api.GetNewsAsync(published: true, pageSize: 3);
        var eventsTask = Api.GetUpcomingEventsAsync(4);
        var activitiesTask = Api.GetActiveActivitiesAsync();
        var hierarchyTask = Api.GetHierarchyAsync();

        await Task.WhenAll(contactTask, newsTask, eventsTask, activitiesTask, hierarchyTask);

        _contact = await contactTask;
        _news = (await newsTask).items;
        _events = await eventsTask;
        _activities = await activitiesTask;
        _hierarchy = await hierarchyTask;
        
        _loading = false;
    }

    private static string ActivityImage(SchoolActivity activity) =>
        activity.Category?.ToLowerInvariant() switch
        {
            "science" => "/images/future-learning.webp",
            "sport" => "/images/learning-together.webp",
            _ => "/images/digital-learning.webp"
        };

    private static string Truncate(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        return text.Length <= maxLength ? text : text[..maxLength] + "…";
    }
}