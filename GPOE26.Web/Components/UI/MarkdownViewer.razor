@inject IJSRuntime JSRuntime

<div class="markdown-viewer" @ref="_container">
    @((MarkupString)_html)
</div>

@code {
    [Parameter] public string Content { get; set; } = string.Empty;

    private string _html = string.Empty;
    private ElementReference _container;
    private string _lastContent = string.Empty;

    protected override void OnParametersSet()
    {
        if (Content != _lastContent)
        {
            _lastContent = Content;
            _html = ToHtml(Content);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!string.IsNullOrWhiteSpace(_html))
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("markdownInterop.renderEffects", _container);
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }
    }

    // Même rendu que l'espace d'apprentissage : sans HTML brut, sans attributs libres, sans lien « javascript: »
    public static string ToHtml(string markdown) =>
        string.IsNullOrWhiteSpace(markdown) ? string.Empty : GPOE26.UI.Services.MarkdownRenderer.Render(markdown).Html;
}
