<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GPOE26.Web.styles.css"]" />
    <link rel="stylesheet" href="css/cours.css" />
    <link rel="stylesheet" href="@Assets["css/site.css"]" />
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["_content/GPOE26.UI/gpoe-app.css"]" />
    
    @* Formules (KaTeX 0.16.8) et code (Prism 1.29.0), hébergés par le site : ils fonctionnent même quand un CDN est lent ou bloqué *@
    <link rel="stylesheet" href="@Assets["lib/katex/katex.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/prism/themes/prism-twilight.min.css"]" />
    
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />

    @* Affiché par Blazor quand la page ne peut plus fonctionner (erreur grave, connexion au serveur perdue) *@
    <div id="blazor-error-ui" role="alert">
        Un problème empêche la page de fonctionner.
        <a href="" class="reload">Recharger la page</a>
        <button type="button" class="dismiss" aria-label="Fermer">×</button>
    </div>
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    
    <script src="@Assets["lib/katex/katex.min.js"]"></script>
    <script src="@Assets["lib/prism/prism.min.js"]"></script>
    <script src="@Assets["lib/prism/components/prism-csharp.min.js"]"></script>
    <script src="@Assets["lib/prism/components/prism-python.min.js"]"></script>
    <script src="@Assets["lib/prism/components/prism-javascript.min.js"]"></script>
    
    <!-- JS Interop -->
    <script src="js/markdown-interop.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Un seul circuit interactif pour toute l'application : la session (SessionState, une par circuit)
    // survit à la navigation. Sans prérendu, la session est restaurée depuis le navigateur avant le premier affichage.
    private static readonly IComponentRenderMode Interactive = new InteractiveServerRenderMode(prerender: false);

    // Seule la page d'erreur ([ExcludeFromInteractiveRouting]) est rendue sans circuit :
    // elle doit s'afficher même quand le serveur vient d'échouer
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? Interactive : null;
}
