# Copier en .env (ignoré par git) puis : set -a && source .env && set +a && bash start.sh

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=gpoe26
PGUSER=postgres
PGPASSWORD=

# LLM (services Chat et Quiz) : clé OpenRouter (https://openrouter.ai/keys) — modèles gratuits par défaut,
# voir LLM:Models / LLM:VisionModels dans Chat/appsettings.json et Quiz/appsettings.json
LLM_API_KEY=
